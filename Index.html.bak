                            <option value="2001">2001</option>
                            <option value="2000">2000</option>
                            <option value="1999">1999</option>
                            <option value="1998">1998</option>
                            <option value="1997">1997</option>
                            <option value="1996">1996</option>
                            <option value="1995">1995</option>
                            <option value="1994">1994</option>
                            <option value="1993">1993</option>
                            <option value="1992">1992</option>
                            <option value="1991">1991</option>
                            <option value="1990">1990</option>
                            <option value="1989">1989</option>
                            <option value="1988">1988</option>
                            <option value="1987">1987</option>
                            <option value="1986">1986</option>
                            <option value="1985">1985</option>
                            <option value="1984">1984</option>
                            <option value="1983">1983</option>
                            <option value="1982">1982</option>
                            <option value="1981">1981</option>
                            <option value="1980">1980</option>
                            <option value="1979">1979</option>
                            <option value="1978">1978</option>
                            <option value="1977">1977</option>
                            <option value="1976">1976</option>
                            <option value="1975">1975</option>
                        </select>
                        <select id="adminStatQuarter" onchange="handleAdminFilterChange('quarter')" class="input-clean text-xs font-bold">
                            <option value="all">Tất cả Quý</option>
                            <option value="1">Quý I</option><option value="2">Quý II</option><option value="3">Quý III</option><option value="4">Quý IV</option>
                        </select>
                        <select id="adminStatMonth" onchange="handleAdminFilterChange('month')" class="input-clean text-xs font-bold">
                            <option value="all">Tất cả Tháng</option>
                            <option value="1">Tháng 1</option><option value="2">Tháng 2</option><option value="3">Tháng 3</option>
                            <option value="4">Tháng 4</option><option value="5">Tháng 5</option><option value="6">Tháng 6</option>
                            <option value="7">Tháng 7</option><option value="8">Tháng 8</option><option value="9">Tháng 9</option>
                            <option value="10">Tháng 10</option><option value="11">Tháng 11</option><option value="12">Tháng 12</option>
                        </select>
                    </div>
                </div>

                <!-- 4 THẺ THỐNG KÊ TỔNG QUAN ADMIN -->
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
                    <div class="pro-card p-5 border-l-4 border-l-blue-600">
                        <span class="text-xs font-bold text-slate-500 uppercase tracking-wider block">Tổng Giảng viên / NV</span>
                        <div class="flex items-baseline justify-between mt-2">
                            <span id="adminTotalUsers" class="text-3xl font-black text-slate-900">0</span>
                            <div class="text-[11px] text-slate-500">Nam: <span id="adminTotalMale" class="font-bold text-blue-600">0</span> | Nữ: <span id="adminTotalFemale" class="font-bold text-pink-600">0</span></div>
                        </div>
                    </div>
                    
                    <div class="pro-card p-5 border-l-4 border-l-purple-600">
                        <span class="text-xs font-bold text-slate-500 uppercase tracking-wider block">Tỷ lệ Chuyên gia (PGS/GS/TS)</span>
                        <div class="mt-2">
                            <span id="adminExpertRatio" class="text-3xl font-black text-purple-700">0%</span>
                        </div>
                    </div>
                    
                    <div class="pro-card p-5 border-l-4 border-l-emerald-600">
                        <span id="lblAdminCongBo" class="text-xs font-bold text-slate-500 uppercase tracking-wider block">Bài báo Công bố</span>
                        <div class="mt-2">
                            <span id="adminActiveYear" class="text-3xl font-black text-emerald-700">0</span>
                        </div>
                    </div>
                    
                    <div class="pro-card p-5 border-l-4 border-l-amber-500">
                        <span class="text-xs font-bold text-slate-500 uppercase tracking-wider block">Tổng Kinh phí Đề tài</span>
                        <div class="mt-2">
                            <span id="adminTotalFunding" class="text-3xl font-black text-amber-600">0</span>
                        </div>
                    </div>
                </div>

                <!-- BIỂU ĐỒ & BẢNG XẾP HẠNG -->
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
                    <!-- KHỐI BIỂU ĐỒ (8 Cột) -->
                    <div class="lg:col-span-8 space-y-8">
                        <div class="pro-card p-6">
                            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 pb-2 border-b border-slate-100 gap-3">
                                <h3 id="trendChartTitle" class="text-sm font-extrabold text-slate-800 uppercase tracking-wider">Xu hướng Công bố Khoa học qua các năm</h3>
                                <div class="flex items-center gap-2">
                                    <span class="text-xs text-slate-500 font-medium">Từ</span>
                                    <select id="trendFromYear" onchange="updateTrendChart()" class="input-clean text-xs py-1 px-2 font-bold"></select>
                                    <span class="text-xs text-slate-500 font-medium">Đến</span>
                                    <select id="trendToYear" onchange="updateTrendChart()" class="input-clean text-xs py-1 px-2 font-bold"></select>
                                </div>
                            </div>
                            <div class="relative h-72">
                                <canvas id="trendChart"></canvas>
                            </div>
                        </div>
                        
                        <div class="pro-card p-6">
                            <h3 class="text-sm font-extrabold text-slate-800 uppercase tracking-wider mb-6 pb-2 border-b border-slate-100">Năng lực công bố theo Khoa / Viện</h3>
                            <div class="relative h-72">
                                <canvas id="khoaChart"></canvas>
                            </div>
                        </div>
                    </div>
                    
                    <!-- KHỐI XẾP HẠNG & NGUỒN NHÂN LỰC (4 Cột) -->
                    <div class="lg:col-span-4 space-y-8">
                        <!-- TOP KHOA -->
                        <div class="pro-card p-6">
                            <h3 class="text-xs font-extrabold text-slate-800 uppercase tracking-wider mb-4 flex items-center gap-2">
                                <span>🏆</span> TOP KHOA DẪN ĐẦU (NĂM NAY)
                            </h3>
                            <div id="adminTopKhoaBoMon" class="space-y-3"></div>
                        </div>
                        
                        <!-- TOP GIẢNG VIÊN -->
                        <div class="pro-card p-6">
                            <h3 class="text-xs font-extrabold text-slate-800 uppercase tracking-wider mb-4 flex items-center gap-2">
                                <span>🌟</span> TOP 5 GIẢNG VIÊN XUẤT SẮC
                            </h3>
                            <div id="adminTopTeachers" class="space-y-3"></div>
                        </div>

                        <!-- NGUỒN NHÂN LỰC SẴN SÀNG -->
                        <div class="pro-card p-6">
                            <h3 class="text-xs font-extrabold text-slate-800 uppercase tracking-wider mb-4 flex items-center gap-2">
                                <span>🤝</span> NGUỒN NHÂN LỰC SẴN SÀNG
                            </h3>
                            <div class="space-y-3 text-sm">
                                <div class="flex justify-between items-center py-2 border-b border-slate-100">
                                    <span class="text-slate-600 font-medium">Thỉnh giảng</span>
                                    <span id="adminNlThinhGiang" class="font-black text-blue-700 bg-blue-50 px-2 py-0.5 rounded-md">0</span>
                                </div>
                                <div class="flex justify-between items-center py-2 border-b border-slate-100">
                                    <span class="text-slate-600 font-medium">Nghiên cứu chung</span>
                                    <span id="adminNlNghienCuu" class="font-black text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-md">0</span>
                                </div>
                                <div class="flex justify-between items-center py-2 border-b border-slate-100">
                                    <span class="text-slate-600 font-medium">Hướng dẫn học viên</span>
                                    <span id="adminNlHuongDan" class="font-black text-purple-700 bg-purple-50 px-2 py-0.5 rounded-md">0</span>
                                </div>
                                <div class="flex justify-between items-center py-2">
                                    <span class="text-slate-600 font-medium">Dự án Doanh nghiệp</span>
                                    <span id="adminNlDoanhNghiep" class="font-black text-amber-700 bg-amber-50 px-2 py-0.5 rounded-md">0</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- HEADHUNTER TÌM KIẾM NHÂN TÀI -->
                <div class="pro-card p-6 md:p-8">
                    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 pb-3 border-b border-slate-100 gap-3">
                        <div>
                            <h3 class="text-lg font-bold text-slate-800">🔍 Khai thác Nguồn nhân lực & Headhunter</h3>
                            <p class="text-xs text-slate-500">Tra cứu, tuyển chọn giảng viên & chuyên gia nghiên cứu theo tiêu chí</p>
                        </div>
                        <button onclick="exportSelectedCVs()" id="btnExportSelectedCV" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2.5 rounded-xl font-bold text-xs flex items-center gap-2 shadow-sm transition">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                            <span>Xuất CV Mẫu chuẩn</span>
                        </button>
                    </div>
                    
                    <div class="grid grid-cols-2 md:grid-cols-5 gap-3 mb-6">
                        <select id="filterKhoa" class="input-clean text-xs font-medium">
                            <option value="">-- Khoa / Viện --</option>
                        </select>
                        <select id="filterHocVi" class="input-clean text-xs font-medium">
                            <option value="">-- Trình độ --</option>
                            <option value="Thạc sĩ">Từ Thạc sĩ trở lên</option>
                            <option value="Tiến sĩ">Từ Tiến sĩ trở lên</option>
                            <option value="Giáo sư">PGS / GS</option>
                        </select>
                        <select id="filterTuoi" class="input-clean text-xs font-medium">
                            <option value="">-- Độ tuổi --</option>
                            <option value="under35">Dưới 35 tuổi (Trẻ)</option>
                            <option value="35to50">Từ 35 - 50 tuổi</option>
                            <option value="over50">Trên 50 tuổi (Kinh nghiệm)</option>
                        </select>
                        <select id="filterNguyenvong" class="input-clean text-xs font-medium">
                            <option value="">-- Nguyện vọng --</option>
                            <option value="hoiDong">Tham gia Hội đồng</option>
                            <option value="huongDan">Hướng dẫn học viên</option>
                            <option value="doanhNghiep">Dự án Doanh nghiệp</option>
                        </select>
                        <button onclick="filterCandidates()" class="bg-slate-900 hover:bg-black text-white px-4 py-2 rounded-xl text-xs font-bold transition flex items-center justify-center gap-1.5 shadow-sm">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                            <span>Lọc danh sách</span>
                        </button>
                    </div>
                    
                    <div class="overflow-hidden border border-slate-200 rounded-2xl">
                        <table class="table-modern w-full text-left">
                            <thead>
                                <tr>
                                    <th class="p-3 w-10 text-center"><input type="checkbox" onclick="toggleSelectAll(this)" class="w-4 h-4 text-blue-600 rounded"></th>
                                    <th class="p-3 font-bold text-slate-700">Họ và tên</th>
                                    <th class="p-3 font-bold text-slate-700">Đơn vị công tác</th>
                                    <th class="p-3 font-bold text-slate-700 text-center">Trình độ</th>
                                    <th class="p-3 font-bold text-slate-700 text-center">Số lượng bài</th>
                                </tr>
                            </thead>
                            <tbody id="candidateResults">
                                <tr><td colspan="5" class="p-6 text-center text-slate-400 italic">Bấm "Lọc danh sách" để hiển thị dữ liệu</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                </div> <!-- ĐÓNG admin-stats-subview -->

                <!-- SUB-VIEW 2: GIÁM SÁT HỒ SƠ CÁN BỘ GIẢNG VIÊN TOÀN TRƯỜNG -->
                <div id="admin-monitor-subview" class="hidden space-y-6">
                    <div class="pro-card p-6 md:p-8">
                        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-5 border-b border-slate-100">
                            <div>
                                <h3 class="text-lg md:text-xl font-bold text-slate-800 flex items-center gap-2">
                                    <span>Giám sát Hồ sơ Giảng viên Toàn trường</span>
                                    <span id="adminMonitorCountBadge" class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-100 text-blue-700">0 cán bộ</span>
                                </h3>
                                <p class="text-xs text-slate-500 mt-1">Giám sát tổng hợp công trình nghiên cứu, bài báo và tiến độ hoàn thiện lý lịch khoa học</p>
                            </div>
                            
                            <!-- Search & Khoa filter -->
                            <div class="flex flex-wrap items-center gap-2.5 w-full sm:w-auto">
                                <div class="relative flex-1 sm:w-64">
                                    <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                                    <input type="text" id="adminMonitorSearchInput" oninput="filterAdminUserDirectory()" placeholder="Tìm tên, email, khoa..." class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-9 pr-3 py-2 text-xs font-semibold text-slate-800 outline-none focus:bg-white focus:border-blue-500 transition shadow-inner">
                                </div>
                                <select id="adminMonitorKhoaFilter" onchange="filterAdminUserDirectory()" class="bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-semibold text-slate-700 outline-none focus:bg-white cursor-pointer">
                                    <option value="all">Tất cả Khoa / Viện</option>
                                </select>
                            </div>
                        </div>

                        <!-- Table of Users -->
                        <div class="overflow-x-auto mt-4">
                            <table class="w-full text-left border-collapse text-xs">
                                <thead>
                                    <tr class="border-b border-slate-200 bg-slate-50/70 text-[11px] font-bold text-slate-500 uppercase tracking-wider">
                                        <th class="py-3 px-3">Cán bộ / Giảng viên</th>
                                        <th class="py-3 px-3">Khoa / Viện công tác</th>
                                        <th class="py-3 px-3 text-center">Học vị / Học hàm</th>
                                        <th class="py-3 px-3 text-center">Bài báo KH</th>
                                        <th class="py-3 px-3 text-center">Đề tài NCKH</th>
                                        <th class="py-3 px-3 text-center">Trạng thái hồ sơ</th>
                                    </tr>
                                </thead>
                                <tbody id="adminMonitorTableBody" class="divide-y divide-slate-100 font-medium text-slate-700">
                                    <tr>
                                        <td colspan="6" class="text-center py-8 text-slate-400 text-xs">Đang tải dữ liệu cán bộ...</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </div> <!-- ĐÓNG admin-dashboard-view -->
          </div> <!-- ĐÓNG max-w-7xl -->
        </section>

        <!-- =========================================================================
             SECTION: THÔNG TIN CƠ BẢN (CHỦ ĐỀ HỒ SƠ CHUYÊN GIA NAVY)
             ========================================================================= -->
        <section id="thong-tin-co-ban" class="content-section">
          <div class="max-w-7xl mx-auto w-full">
            
            <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-8 pb-4 border-b border-slate-200/80 gap-4">
              <div class="flex items-center">
                <span class="title-accent-bar bg-blue-600 shadow-sm shadow-blue-500/40"></span>
                <div>
                  <h1 class="text-2xl md:text-3xl font-extrabold text-slate-900 tracking-tight">Thông tin cơ bản</h1>
                  <p class="text-xs md:text-sm text-slate-500 mt-1">Lý lịch cá nhân, chức vụ, học vị và thông tin liên lạc chính thức</p>
                </div>
              </div>
              
              <div class="flex items-center gap-3">
                  <span id="syncStatusIndicator" class="text-xs font-bold text-emerald-600 bg-emerald-50 border border-emerald-200 px-3 py-1.5 rounded-full opacity-0 transition-opacity duration-300">Đã lưu tạm thời</span>
                  <button id="editBtn" onclick="toggleEditSave()" class="bg-amber-400 hover:bg-amber-500 text-slate-900 px-5 py-2.5 rounded-xl font-bold text-xs shadow-sm flex items-center gap-2 transition duration-200 cursor-pointer">
                    <span id="editBtnText">Chỉnh sửa</span>
                    <svg id="editIcon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
                  </button>
              </div>
            </div>

           <!-- FORM THÔNG TIN CƠ BẢN HIỆN ĐẠI (ĐÃ THÊM AUTO-SAVE) -->
            <form id="basic-info-form" class="pro-card p-6 md:p-8 space-y-6">
    <!-- HÀNG 1: Họ tên, Giới tính, Ngày sinh -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-5">
        <div class="md:col-span-5">
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Họ và tên <span class="text-red-500">*</span></label>
            <input type="text" id="nameInput" readonly oninput="updateWelcomeMessage()" onchange="saveToDatabase()" placeholder="Nhập họ và tên đầy đủ" class="input-clean w-full font-semibold">
        </div>
        <div class="md:col-span-3">
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Giới tính</label>
            <div class="flex items-center gap-5 p-2.5 bg-slate-50 border border-slate-200 rounded-xl">
                <label class="flex items-center gap-1.5 cursor-pointer text-xs font-bold text-slate-700">
                    <input type="radio" name="gender" id="genderNam" disabled onchange="saveToDatabase()" class="w-4 h-4 text-blue-600"> <span>Nam</span>
                </label>
                <label class="flex items-center gap-1.5 cursor-pointer text-xs font-bold text-slate-700">
                    <input type="radio" name="gender" id="genderNu" disabled onchange="saveToDatabase()" class="w-4 h-4 text-pink-600"> <span>Nữ</span>
                </label>
            </div>
        </div>
        <div class="md:col-span-4">
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Ngày sinh</label>
            <input type="date" id="dobInput" readonly onchange="saveToDatabase()" class="input-clean w-full">
        </div>
    </div>
    <!-- HÀNG 2: Quê quán, Nơi sinh, Dân tộc -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-5">
        <div class="md:col-span-4">
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Quê quán</label>
            <select id="queQuanInput" disabled onchange="saveToDatabase()" class="input-clean w-full">
                <option value="">-- Chọn Tỉnh/Thành --</option>
            </select>
        </div>
        <div class="md:col-span-4">
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Nơi sinh</label>
            <select id="noiSinhInput" disabled onchange="saveToDatabase()" class="input-clean w-full">
                <option value="">-- Chọn Tỉnh/Thành --</option>
            </select>
        </div>
        <div class="md:col-span-4">
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Dân tộc</label>
            <select id="danTocInput" disabled onchange="saveToDatabase()" class="input-clean w-full">
                <option value="">-- Chọn Dân tộc --</option>
            </select>
        </div>
    </div>
    <!-- HÀNG 3: Chức vụ, Đơn vị -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-5">
        <div class="md:col-span-6">
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Chức vụ hiện tại</label>
            <input type="text" id="chucVuInput" readonly onchange="saveToDatabase()" placeholder="VD: Phó Trưởng Khoa, Giảng viên chính" class="input-clean w-full">
        </div>
        <div class="md:col-span-6">
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Đơn vị công tác</label>
            <input type="text" id="donViInput" readonly onchange="saveToDatabase()" placeholder="VD: Trường ĐH Công nghệ Kỹ thuật TP.HCM" class="input-clean w-full">
        </div>
    </div>
    <!-- HÀNG 4: Địa chỉ, Email -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-5">
        <div class="md:col-span-7">
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Địa chỉ liên hệ</label>
            <input type="text" id="diaChiInput" readonly onchange="saveToDatabase()" placeholder="Địa chỉ cơ quan / nơi làm việc" class="input-clean w-full">
        </div>
        <div class="md:col-span-5">
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Email chính thức <span class="text-red-500">*</span></label>
            <!-- Email thường giữ nguyên readonly kể cả khi edit, nhưng nếu muốn edit thì gỡ dòng dưới đi -->
            <input type="email" id="emailInput" readonly oninput="updateWelcomeMessage()" onchange="saveToDatabase()" placeholder="email@hcmute.edu.vn" class="input-clean w-full font-medium text-blue-900">
        </div>
    </div>
    <!-- HÀNG 5: Điện thoại -->
    <div class="space-y-2">
        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider">Số điện thoại liên lạc</label>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
            <div>
                <span class="text-[11px] font-bold text-slate-500 mb-1 block">Cơ quan:</span>
                <input type="text" id="cqInput" readonly onchange="saveToDatabase()" placeholder="ĐT Cơ quan" class="input-clean w-full">
            </div>
            <div>
                <span class="text-[11px] font-bold text-slate-500 mb-1 block">Nhà riêng:</span>
                <input type="text" id="nrInput" readonly onchange="saveToDatabase()" placeholder="ĐT Nhà riêng" class="input-clean w-full">
            </div>
            <div>
                <span class="text-[11px] font-bold text-slate-500 mb-1 block">Di động:</span>
                <input type="text" id="ddInput" readonly onchange="saveToDatabase()" placeholder="ĐT Di động" class="input-clean w-full">
            </div>
            <div>
                <span class="text-[11px] font-bold text-slate-500 mb-1 block">Fax:</span>
                <input type="text" id="faxInput" readonly onchange="saveToDatabase()" placeholder="Số Fax" class="input-clean w-full">
            </div>
        </div>
    </div>
    <!-- HÀNG 6: CCCD / Định danh -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 pt-3 border-t border-slate-100">
        <div>
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Số CCCD / CMND</label>
            <input type="text" id="cccdInput" readonly onchange="saveToDatabase()" placeholder="Số định danh cá nhân" class="input-clean w-full">
        </div>
        <div>
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Ngày cấp</label>
            <input type="date" id="ngayCapInput" readonly onchange="saveToDatabase()" class="input-clean w-full">
        </div>
        <div>
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Nơi cấp</label>
            <input type="text" id="noiCapInput" readonly onchange="saveToDatabase()" placeholder="Nơi cấp CCCD" class="input-clean w-full">
        </div>
    </div>
</form>
          </div>
        </section>

        <!-- =========================================================================
             SECTION: THÔNG TIN BỔ SUNG (CHỦ ĐỀ EMERALD SÁNG TẠO & KỸ NĂNG)
             ========================================================================= -->
        <section id="thong-tin-bo-sung" class="content-section">
          <div class="max-w-7xl mx-auto w-full">
            
            <div class="flex items-center mb-8 pb-4 border-b border-slate-200/80">
              <span class="title-accent-bar bg-emerald-600 shadow-sm shadow-emerald-500/40"></span>
              <div>
                <h1 class="text-2xl md:text-3xl font-extrabold text-slate-900 tracking-tight">Thông tin bổ sung</h1>
                <p class="text-xs md:text-sm text-slate-500 mt-1">Môn học giảng dạy, hướng nghiên cứu mũi nhọn và tùy chỉnh nguyện vọng hợp tác</p>
              </div>
            </div>

            <!-- KHỐI TÙY CHỈNH NGUYỆN VỌNG -->
            <div class="pro-card p-6 md:p-8 mb-8 border-l-4 border-l-emerald-500">
              <div class="flex items-center gap-3 mb-6 pb-3 border-b border-slate-100">
                <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                </div>
                <div>
                  <h3 class="text-base md:text-lg font-bold text-slate-800">Tùy chỉnh nguyện vọng chuyên môn</h3>
                  <p class="text-xs text-slate-500">Bật các mục này để Nhà trường và đối tác dễ dàng kết nối dự án phù hợp</p>
                </div>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-4">
    <div class="flex justify-between items-center py-2.5 px-3 rounded-xl hover:bg-slate-50 transition border border-transparent hover:border-slate-100">
        <span class="text-sm font-semibold text-slate-700">1. Sẵn sàng thỉnh giảng các trường bạn</span>
        <label class="relative inline-flex items-center cursor-pointer">
        <input type="checkbox" id="prefThinhGiang" onchange="syncPref('thinhGiang', this.checked)" class="sr-only toggle-checkbox">
        <div class="toggle-label"></div>
        </label>
    </div>
    
    <div class="flex justify-between items-center py-2.5 px-3 rounded-xl hover:bg-slate-50 transition border border-transparent hover:border-slate-100">
        <span class="text-sm font-semibold text-slate-700">2. Tìm kiếm đồng đội nghiên cứu chung</span>
        <label class="relative inline-flex items-center cursor-pointer">
        <input type="checkbox" id="prefNghienCuu" onchange="syncPref('nghienCuu', this.checked)" class="sr-only toggle-checkbox">
        <div class="toggle-label"></div>
        </label>
    </div>
    
    <div class="flex justify-between items-center py-2.5 px-3 rounded-xl hover:bg-slate-50 transition border border-transparent hover:border-slate-100">
        <span class="text-sm font-semibold text-slate-700">3. Tham gia Hội đồng chấm Luận văn / Luận án</span>
        <label class="relative inline-flex items-center cursor-pointer">
        <input type="checkbox" id="prefHoiDong" onchange="syncPref('hoiDong', this.checked)" class="sr-only toggle-checkbox">
        <div class="toggle-label"></div>
        </label>
    </div>
    
    <div class="flex justify-between items-center py-2.5 px-3 rounded-xl hover:bg-slate-50 transition border border-transparent hover:border-slate-100">
        <span class="text-sm font-semibold text-slate-700">4. Tham gia dự án hợp tác Doanh nghiệp</span>
        <label class="relative inline-flex items-center cursor-pointer">
        <input type="checkbox" id="prefDoanhNghiep" onchange="syncPref('doanhNghiep', this.checked)" class="sr-only toggle-checkbox">
        <div class="toggle-label"></div>
        </label>
    </div>
    
    <!-- Xóa bỏ md:col-span-2 ở đây để nút 5 bằng đúng kích thước các nút trên -->
    <div class="flex justify-between items-center py-2.5 px-3 rounded-xl hover:bg-slate-50 transition border border-transparent hover:border-slate-100">
        <span class="text-sm font-semibold text-slate-700">5. Nhận hướng dẫn Học viên CH & NCS</span>
        <label class="relative inline-flex items-center cursor-pointer">
        <input type="checkbox" id="prefHuongDan" onchange="syncPref('huongDan', this.checked)" class="sr-only toggle-checkbox">
        <div class="toggle-label"></div>
        </label>
    </div>
</div>

            <!-- BẢNG MÔN HỌC & HƯỚNG NGHIÊN CỨU -->
