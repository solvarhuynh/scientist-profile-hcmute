      <!-- =========================================================================
           KHU VỰC NỘI DUNG CHÍNH (CONTENT AREA)
           ========================================================================= -->
      <main id="main-content">
        <!-- BREADCRUMB CONTEXT BAR -->
        <div class="px-6 md:px-10 py-3 bg-white/80 border-b border-slate-200/80 flex items-center justify-between shrink-0 backdrop-blur-sm z-10">
          <div class="flex items-center text-xs text-slate-500 font-medium">
            <span class="hover:text-blue-600 transition cursor-default">Hồ sơ cá nhân</span>
            <svg class="w-3.5 h-3.5 mx-2 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
            <span id="breadcrumb-current" class="font-bold text-blue-700 bg-blue-50 px-2.5 py-0.5 rounded-lg border border-blue-200/60">Tổng quan</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span class="text-[11px] text-slate-400 font-semibold uppercase tracking-wider">Hệ thống trực tuyến</span>
          </div>
        </div>

        <!-- =========================================================================
             SECTION: TỔNG QUAN (CHỦ ĐỀ CÔNG NGHỆ & DASHBOARD DỮ LIỆU)
             ========================================================================= -->
        <section id="tong-quan" class="content-section active-section">
          <div class="max-w-7xl mx-auto w-full">
            
            <!-- Page Header -->
            <div class="flex flex-col md:flex-row md:items-center justify-between mb-8 pb-4 border-b border-slate-200/80 gap-4">
              <div class="flex items-center">
                <span class="title-accent-bar bg-red-600 shadow-sm shadow-red-500/40"></span>
                <div>
                  <h1 class="text-2xl md:text-3xl font-extrabold text-slate-900 tracking-tight flex items-center flex-wrap gap-2">
                    Tổng quan hồ sơ khoa học
                  </h1>
                  <p class="text-xs md:text-sm text-slate-500 mt-1">
                    Xin chào, <span id="welcomeNameDisplay" class="font-bold text-blue-600">[Đang tải dữ liệu...]</span>! Thống kê hoạt động nghiên cứu & công bố khoa học.
                  </p>
                </div>
              </div>
            </div>
            
            <!-- ================= DASHBOARD DÀNH CHO USER (GIẢNG VIÊN) ================= -->
            <div id="user-dashboard-view" class="space-y-8">
                
                <!-- KHỐI 1: ĐƠN VỊ CÔNG TÁC -->
                <div class="pro-card p-6 md:p-8">
                    <div class="flex items-center gap-3 mb-6 pb-3 border-b border-slate-100">
                        <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
                        </div>
                        <div>
                            <h3 class="text-base md:text-lg font-bold text-slate-800">Đơn vị công tác chuyên môn</h3>
                            <p class="text-xs text-slate-500">Khoa / Viện và Bộ môn quản lý trực thuộc</p>
                        </div>
                    </div>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-2">Khoa / Viện quản lý</label>
                            <select id="khoaSelect" onchange="handleKhoaChange()" class="input-clean w-full font-medium">
                                <option value="">-- Chọn Khoa / Viện --</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-2">Bộ môn trực thuộc</label>
                            <select id="boMonSelect" onchange="saveKhoaBoMon()" class="input-clean w-full font-medium">
                                <option value="">-- Chọn Bộ môn --</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- KHỐI 2: THỐNG KÊ CÔNG BỐ KHOA HỌC -->
                <div class="pro-card p-6 md:p-8">
                    <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center mb-6 pb-4 border-b border-slate-100 gap-4">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center shrink-0">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
                            </div>
                            <div>
                                <h3 class="text-base md:text-lg font-bold text-slate-800">Thống kê Bài báo Khoa học</h3>
                                <p class="text-xs text-slate-500">Bộ lọc phân loại công trình công bố theo chu kỳ</p>
                            </div>
                        </div>
                        
                        <!-- Toolbar Bộ lọc giống mẫu ảnh -->
                        <div class="flex flex-wrap items-center gap-2.5">
                            <button onclick="resetDashboardFilters()" class="flex items-center gap-1 px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-semibold transition">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                                <span>Reset</span>
                            </button>
                            
                            <!-- Chọn Năm -->
                            <div class="flex items-center bg-white border border-slate-200 rounded-xl px-2 py-1 shadow-sm">
                                <svg class="w-4 h-4 text-slate-400 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                <select id="statYear" onchange="updateDashboardStats()" class="bg-transparent text-xs font-semibold text-slate-700 outline-none cursor-pointer py-1">
                                    <option value="all">Tất cả Năm</option>
                                    <option value="2027">2027</option>
                                    <option value="2026">2026</option>
                                    <option value="2025">2025</option>
                                    <option value="2024">2024</option>
                                    <option value="2023">2023</option>
                                    <option value="2022">2022</option>
                                    <option value="2021">2021</option>
                                    <option value="2020">2020</option>
                                    <option value="2019">2019</option>
                                    <option value="2018">2018</option>
                                    <option value="2017">2017</option>
                                    <option value="2016">2016</option>
                                    <option value="2015">2015</option>
                                    <option value="2014">2014</option>
                                    <option value="2013">2013</option>
                                    <option value="2012">2012</option>
                                    <option value="2011">2011</option>
                                    <option value="2010">2010</option>
                                    <option value="2009">2009</option>
                                    <option value="2008">2008</option>
                                    <option value="2007">2007</option>
                                    <option value="2006">2006</option>
                                    <option value="2005">2005</option>
                                    <option value="2004">2004</option>
                                    <option value="2003">2003</option>
                                    <option value="2002">2002</option>
                                    <option value="2001">2001</option>
                                    <option value="2000">2000</option>
                                    <option value="1999">1999</option>
                                    <option value="1998">1998</option>
                                    <option value="1997">1997</option>
                                    <option value="1996">1996</option>
                                    <option value="1995">1995</option>
                                    <option value="1994">1994</option>
                                    <option value="1993">1993</option>
                                    <option value="1992">1992</option>
                                    <option value="1991">1991</option>
                                    <option value="1990">1990</option>
                                    <option value="1989">1989</option>
                                    <option value="1988">1988</option>
                                    <option value="1987">1987</option>
                                    <option value="1986">1986</option>
                                    <option value="1985">1985</option>
                                    <option value="1984">1984</option>
                                    <option value="1983">1983</option>
                                    <option value="1982">1982</option>
                                    <option value="1981">1981</option>
                                    <option value="1980">1980</option>
                                    <option value="1979">1979</option>
                                    <option value="1978">1978</option>
                                    <option value="1977">1977</option>
                                    <option value="1976">1976</option>
                                    <option value="1975">1975</option>
                                </select>
                            </div>
                            
                            <!-- Chọn Quý -->
                            <div class="flex items-center bg-white border border-slate-200 rounded-xl px-2 py-1 shadow-sm">
                                <select id="statQuarter" onchange="handleDashboardFilterChange('statQuarter')" class="bg-transparent text-xs font-semibold text-slate-700 outline-none cursor-pointer py-1">
                                    <option value="all">Tất cả Quý</option>
                                    <option value="1">Quý I</option>
                                    <option value="2">Quý II</option>
                                    <option value="3">Quý III</option>
                                    <option value="4">Quý IV</option>
                                </select>
                            </div>
                            
                            <!-- Chọn Tháng -->
                            <div class="flex items-center bg-white border border-slate-200 rounded-xl px-2 py-1 shadow-sm">
                                <select id="statMonth" onchange="handleDashboardFilterChange('statMonth')" class="bg-transparent text-xs font-semibold text-slate-700 outline-none cursor-pointer py-1">
                                    <option value="all">Tất cả Tháng</option>
                                    <option value="1">Tháng 1</option><option value="2">Tháng 2</option><option value="3">Tháng 3</option>
                                    <option value="4">Tháng 4</option><option value="5">Tháng 5</option><option value="6">Tháng 6</option>
                                    <option value="7">Tháng 7</option><option value="8">Tháng 8</option><option value="9">Tháng 9</option>
                                    <option value="10">Tháng 10</option><option value="11">Tháng 11</option><option value="12">Tháng 12</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- 3 Ô THỐNG KÊ (HIỆU ỨNG HIỆN ĐẠI) -->
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <div class="p-6 rounded-2xl bg-gradient-to-br from-blue-500/10 via-sky-50 to-blue-50/40 border border-blue-200/80 flex flex-col items-center justify-center relative overflow-hidden group hover:scale-[1.02] transition-transform">
                            <div class="absolute top-0 right-0 w-24 h-24 bg-blue-500/5 rounded-full -mr-8 -mt-8"></div>
                            <span class="text-blue-700 text-xs font-extrabold uppercase tracking-widest mb-1">Tổng số bài báo</span>
                            <span id="statTotal" class="text-5xl font-black text-blue-900 tracking-tight my-1">0</span>
                            <span class="text-[11px] text-blue-600/80 font-medium">Toàn bộ công trình</span>
                        </div>
                        
                        <div class="p-6 rounded-2xl bg-gradient-to-br from-emerald-500/10 via-emerald-50 to-teal-50/40 border border-emerald-200/80 flex flex-col items-center justify-center relative overflow-hidden group hover:scale-[1.02] transition-transform">
                            <div class="absolute top-0 right-0 w-24 h-24 bg-emerald-500/5 rounded-full -mr-8 -mt-8"></div>
                            <span class="text-emerald-700 text-xs font-extrabold uppercase tracking-widest mb-1">Trong nước</span>
                            <span id="statDomestic" class="text-5xl font-black text-emerald-900 tracking-tight my-1">0</span>
                            <span class="text-[11px] text-emerald-600/80 font-medium">Tạp chí & Kỷ yếu quốc gia</span>
                        </div>
                        
                        <div class="p-6 rounded-2xl bg-gradient-to-br from-purple-500/10 via-purple-50 to-indigo-50/40 border border-purple-200/80 flex flex-col items-center justify-center relative overflow-hidden group hover:scale-[1.02] transition-transform">
                            <div class="absolute top-0 right-0 w-24 h-24 bg-purple-500/5 rounded-full -mr-8 -mt-8"></div>
                            <span class="text-purple-700 text-xs font-extrabold uppercase tracking-widest mb-1">Nước ngoài (ISI/Scopus)</span>
                            <span id="statIntl" class="text-5xl font-black text-purple-900 tracking-tight my-1">0</span>
                            <span class="text-[11px] text-purple-600/80 font-medium">Tạp chí Quốc tế uy tín</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ================= DASHBOARD DÀNH CHO ADMIN ================= -->
            <div id="admin-dashboard-view" class="hidden space-y-8">
                
                <!-- SUB-VIEW 1: THỐNG KÊ & BIỂU ĐỒ ADMIN (DASHBOARD) -->
                <div id="admin-stats-subview" class="space-y-8">
                
                <!-- BỘ LỌC THỜI GIAN ADMIN -->
                <div class="pro-card p-6 flex flex-col md:flex-row justify-between items-center gap-4">
                    <div class="flex items-center gap-3">
                        <div>
                            <h3 class="font-bold text-slate-800 text-sm sm:text-base">Bộ lọc Phân tích Dữ liệu Toàn trường</h3>
                            <p class="text-xs text-slate-500">Thống kê tổng hợp số liệu khoa học toàn bộ cán bộ giảng viên</p>
                        </div>
                    </div>
                    
                    <div class="flex flex-wrap items-center gap-2">
                        <button onclick="resetAdminFilters()" class="flex items-center gap-1 px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-semibold transition">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                            <span>Reset</span>
                        </button>
                        <select id="adminStatYear" onchange="handleAdminFilterChange('year')" class="input-clean text-xs font-bold">
                            <option value="all">Tất cả Năm</option>
                            <option value="2027">2027</option>
                            <option value="2026">2026</option>
                            <option value="2025">2025</option>
                            <option value="2024">2024</option>
