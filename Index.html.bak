<script>
// BIẾN ĐƯỢC GOOGLE APPS SCRIPT TRUYỀN TRỰC TIẾP TỪ SERVER TEMPLATE
window.SERVER_PASSED_ROLE = '<?= typeof serverRole !== "undefined" ? serverRole : "" ?>';
window.SERVER_PASSED_EMAIL = '<?= typeof serverEmail !== "undefined" ? serverEmail : "" ?>';

// --- CÁC HÀM TIỆN ÍCH BỔ SUNG CHO GIAO DIỆN HIỆN ĐẠI ---
function toggleSidebarCollapse() {
    var aside = document.getElementById('sidebar-aside');
    if (aside) aside.classList.toggle('sidebar-collapsed');
}

function toggleDemoRole(role) {
    var userView = document.getElementById('user-dashboard-view');
    var adminView = document.getElementById('admin-dashboard-view');
    var userNav = document.getElementById('user-sidebar-nav');
    var adminNav = document.getElementById('admin-sidebar-nav');
    var roleBadge = document.getElementById('roleBadge');
    var btnSwitchAdmin = document.getElementById('btnSwitchToAdmin');
    var btnSwitchUser = document.getElementById('btnSwitchToUser');
    var btnUser = document.getElementById('btnDemoUser');
    var btnAdmin = document.getElementById('btnDemoAdmin');
    
    if (role === 'admin') {
        if (roleBadge) { roleBadge.innerText = 'ADMIN'; roleBadge.classList.remove('hidden'); }
        if (userView) userView.classList.add('hidden');
        if (adminView) adminView.classList.remove('hidden');
        if (userNav) userNav.classList.add('hidden');
        if (adminNav) adminNav.classList.remove('hidden');
        if (btnSwitchAdmin) btnSwitchAdmin.classList.add('hidden');
        if (btnSwitchUser) btnSwitchUser.classList.remove('hidden');
        if (btnAdmin) { btnAdmin.className = 'px-2.5 py-1 rounded-lg font-bold transition-all bg-white text-blue-900 shadow-sm'; }
        if (btnUser) { btnUser.className = 'px-2.5 py-1 rounded-lg font-medium text-white hover:bg-white/10 transition-all'; }
        switchSection('tong-quan');
        switchAdminSubTab('thong-ke');
        if (window.globalAdminData) renderAdminDashboard(window.globalAdminData);
        showToast("Đã chuyển sang chế độ Quản trị viên (Admin)", "info");
    } else {
        if (roleBadge) { roleBadge.classList.add('hidden'); }
        if (userView) userView.classList.remove('hidden');
        if (adminView) adminView.classList.add('hidden');
        if (userNav) userNav.classList.remove('hidden');
        if (adminNav) adminNav.classList.add('hidden');
        if (btnSwitchUser) btnSwitchUser.classList.add('hidden');
        if (btnSwitchAdmin) btnSwitchAdmin.classList.remove('hidden');
        if (btnUser) { btnUser.className = 'px-2.5 py-1 rounded-lg font-bold transition-all bg-white text-blue-900 shadow-sm'; }
        if (btnAdmin) { btnAdmin.className = 'px-2.5 py-1 rounded-lg font-medium text-white hover:bg-white/10 transition-all'; }
        switchSection('tong-quan');
        showToast("Đã chuyển sang chế độ Giảng viên (User)", "info");
    }
}

// Chuyển đổi qua lại giữa Cổng Quản trị và Hồ sơ Giảng viên (Dành cho tài khoản có quyền Admin)
function switchToAdminPortal() {
    window.currentActiveRole = 'admin';
    sessionStorage.setItem('currentUserRole', 'admin');
    localStorage.setItem('currentUserRole', 'admin');
    if (document.getElementById('user-dashboard-view')) document.getElementById('user-dashboard-view').classList.add('hidden');
    if (document.getElementById('admin-dashboard-view')) document.getElementById('admin-dashboard-view').classList.remove('hidden');
    if (document.getElementById('user-sidebar-nav')) document.getElementById('user-sidebar-nav').classList.add('hidden');
    if (document.getElementById('admin-sidebar-nav')) document.getElementById('admin-sidebar-nav').classList.remove('hidden');
    if (document.getElementById('btnSwitchToAdmin')) document.getElementById('btnSwitchToAdmin').classList.add('hidden');
    if (document.getElementById('btnSwitchToUser')) document.getElementById('btnSwitchToUser').classList.remove('hidden');
    if (document.getElementById('topbarBtnHoTro')) document.getElementById('topbarBtnHoTro').classList.add('hidden');
    if (document.getElementById('btnExportCV')) document.getElementById('btnExportCV').classList.add('hidden');
    if (document.getElementById('roleBadge')) document.getElementById('roleBadge').classList.remove('hidden');
    
    switchSection('tong-quan');
    switchAdminSubTab('thong-ke');
    
    if (!window.globalAdminData) {
        if (typeof google !== 'undefined' && google.script && google.script.run) {
            google.script.run
                .withSuccessHandler(function(adminData) {
                    window.globalAdminData = adminData;
                    renderAdminDashboard(adminData);
                    renderAdminUserDirectory();
                })
                .getAdminDashboardData();
        } else {
            initOfflineDemoData();
        }
    } else {
        renderAdminDashboard(window.globalAdminData);
        renderAdminUserDirectory();
    }
    showToast('Đã chuyển sang Bảng điều khiển Quản trị viên', 'info');
}

function switchToUserPortal() {
    window.currentActiveRole = 'user';
    sessionStorage.setItem('currentUserRole', 'user');
    localStorage.setItem('currentUserRole', 'user');
    if (document.getElementById('admin-dashboard-view')) document.getElementById('admin-dashboard-view').classList.add('hidden');
    if (document.getElementById('user-dashboard-view')) document.getElementById('user-dashboard-view').classList.remove('hidden');
    if (document.getElementById('admin-sidebar-nav')) document.getElementById('admin-sidebar-nav').classList.add('hidden');
    if (document.getElementById('user-sidebar-nav')) document.getElementById('user-sidebar-nav').classList.remove('hidden');
    if (document.getElementById('btnSwitchToUser')) document.getElementById('btnSwitchToUser').classList.add('hidden');
    if (document.getElementById('btnSwitchToAdmin')) document.getElementById('btnSwitchToAdmin').classList.remove('hidden');
    if (document.getElementById('topbarBtnHoTro')) document.getElementById('topbarBtnHoTro').classList.remove('hidden');
    if (document.getElementById('btnExportCV')) document.getElementById('btnExportCV').classList.remove('hidden');
    
    switchSection('tong-quan');
    var breadcrumb = document.getElementById('breadcrumb-current');
    if (breadcrumb) breadcrumb.innerText = 'Tổng quan';
    showToast('Đã chuyển về Hồ sơ Giảng viên cá nhân', 'info');
}

// Chuyển tab con trong giao diện Admin: Thống kê vs Giám sát
function switchAdminSubTab(tab) {
    if (window.innerWidth < 1024) { closeMobileSidebar(); }
    var menuThongKe = document.getElementById('admin-menu-thong-ke');
    var menuGiamSat = document.getElementById('admin-menu-giam-sat');
    var statsSubview = document.getElementById('admin-stats-subview');
    var monitorSubview = document.getElementById('admin-monitor-subview');
    var breadcrumb = document.getElementById('breadcrumb-current');

    // Đảm bảo section tong-quan luôn hiển thị
    switchSection('tong-quan');

    if (tab === 'giam-sat') {
        if (menuThongKe) menuThongKe.classList.remove('active');
        if (menuGiamSat) menuGiamSat.classList.add('active');
        if (statsSubview) statsSubview.classList.add('hidden');
        if (monitorSubview) monitorSubview.classList.remove('hidden');
        if (breadcrumb) breadcrumb.innerText = 'Giám sát Giảng viên';
        renderAdminUserDirectory();
    } else {
        // Mặc định: 'thong-ke'
        if (menuGiamSat) menuGiamSat.classList.remove('active');
        if (menuThongKe) menuThongKe.classList.add('active');
        if (monitorSubview) monitorSubview.classList.add('hidden');
        if (statsSubview) statsSubview.classList.remove('hidden');
        if (breadcrumb) breadcrumb.innerText = 'Thống kê toàn trường';
        if (window.globalAdminData) {
            updateAdminStats();
            updateTrendChart();
        }
    }
}

// Render Bảng Giám sát Giảng viên
function renderAdminUserDirectory() {
    var data = window.globalAdminData;
    if (!data || !data.users) return;

    var khoaSelect = document.getElementById('adminMonitorKhoaFilter');
    if (khoaSelect && khoaSelect.options.length <= 1) {
        var existingKhoas = new Set();
        data.users.forEach(function(u) {
            var k = u.khoa || u.donVi;
            if (k && k !== 'HCMUTE' && k !== 'Trường Đại học Công nghệ Kỹ thuật TP.HCM') existingKhoas.add(k);
        });
        for (var kName in DATA_KHOA_BOMON) {
            existingKhoas.add(kName);
        }
        var sortedKhoas = Array.from(existingKhoas).sort();
        sortedKhoas.forEach(function(k) {
            var opt = document.createElement('option');
            opt.value = k;
            opt.textContent = k;
            khoaSelect.appendChild(opt);
        });
    }

    filterAdminUserDirectory();
}

// Lọc dữ liệu trong Bảng Giám sát
function filterAdminUserDirectory() {
    var data = window.globalAdminData;
    var tbody = document.getElementById('adminMonitorTableBody');
    var badge = document.getElementById('adminMonitorCountBadge');
    if (!data || !data.users || !tbody) return;

    var searchVal = (document.getElementById('adminMonitorSearchInput') ? document.getElementById('adminMonitorSearchInput').value : '').toLowerCase().trim();
    var khoaVal = (document.getElementById('adminMonitorKhoaFilter') ? document.getElementById('adminMonitorKhoaFilter').value : 'all');

    var filteredUsers = data.users.filter(function(u) {
        var matchSearch = true;
        if (searchVal) {
            var fullStr = ((u.name || '') + ' ' + (u.email || '') + ' ' + (u.khoa || '') + ' ' + (u.boMon || '') + ' ' + (u.donVi || '')).toLowerCase();
            matchSearch = fullStr.includes(searchVal);
        }
        var matchKhoa = true;
        if (khoaVal && khoaVal !== 'all') {
            matchKhoa = (u.khoa === khoaVal || u.donVi === khoaVal);
        }
        return matchSearch && matchKhoa;
    });

    if (badge) {
        badge.innerText = filteredUsers.length + ' / ' + data.users.length + ' cán bộ';
    }

    if (filteredUsers.length === 0) {
        tbody.innerHTML = '<tr><td colspan="6" class="text-center py-10 text-slate-400 text-xs font-medium">Không tìm thấy cán bộ / giảng viên nào phù hợp bộ lọc.</td></tr>';
        return;
    }

    var html = '';
    filteredUsers.forEach(function(u) {
        var userDT = (data.daoTao || []).filter(function(dt) { return dt.email === u.email; });
        var hocHam = userDT.find(function(dt) { return dt.loai === 'Học hàm'; });
        var hocViList = userDT.filter(function(dt) { return dt.loai === 'Học vị' || !dt.loai; });
        
        var academicTitle = 'Cử nhân / Kỹ sư';
        if (hocHam && hocHam.hocVi) {
            academicTitle = hocHam.hocVi;
        } else if (hocViList.some(function(dt) { return String(dt.hocVi).includes('Tiến sĩ'); })) {
            academicTitle = 'Tiến sĩ';
        } else if (hocViList.some(function(dt) { return String(dt.hocVi).includes('Thạc sĩ'); })) {
            academicTitle = 'Thạc sĩ';
        } else if (u.name && (u.name.startsWith('GS.') || u.name.startsWith('PGS.'))) {
            academicTitle = u.name.split(' ')[0] + ' ' + u.name.split(' ')[1];
        } else if (u.name && u.name.startsWith('TS.')) {
            academicTitle = 'Tiến sĩ';
        } else if (u.name && u.name.startsWith('ThS.')) {
            academicTitle = 'Thạc sĩ';
        }

        var paperCount = (data.congBo || []).filter(function(cb) { return cb.email === u.email; }).length;
        var projectCount = (data.deTai || []).filter(function(dt) { return dt.email === u.email; }).length;

        var statusBadge = (paperCount > 0 || projectCount > 0)
            ? '<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-700">Đã có công trình</span>'
            : '<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 text-slate-600">Đang cập nhật</span>';

        html += '<tr class="hover:bg-slate-50 transition border-b border-slate-100">' +
            '<td class="py-3 px-3">' +
                '<div class="font-bold text-slate-800">' + (u.name || 'Chưa cập nhật') + '</div>' +
                '<div class="text-[11px] text-slate-400 font-mono">' + (u.email || '') + '</div>' +
            '</td>' +
            '<td class="py-3 px-3">' +
                '<div class="font-medium text-slate-700">' + (u.khoa || u.donVi || 'Chưa phân khoa') + '</div>' +
                (u.boMon ? ('<div class="text-[11px] text-slate-400">' + u.boMon + '</div>') : '') +
            '</td>' +
            '<td class="py-3 px-3 text-center">' +
                '<span class="px-2 py-0.5 rounded-md bg-blue-50 text-blue-700 font-semibold text-[11px]">' + academicTitle + '</span>' +
            '</td>' +
            '<td class="py-3 px-3 text-center font-bold text-slate-800">' + paperCount + '</td>' +
            '<td class="py-3 px-3 text-center font-bold text-slate-800">' + projectCount + '</td>' +
            '<td class="py-3 px-3 text-center">' + statusBadge + '</td>' +
        '</tr>';
    });

    tbody.innerHTML = html;
}

// Xuất Báo cáo Thống kê Toàn trường ra file CSV chuẩn UTF-8
function exportAdminDashboardReport() {
    var data = window.globalAdminData;
    if (!data || !data.users || data.users.length === 0) {
        showToast('Chưa có dữ liệu thống kê để xuất báo cáo!', 'warning');
        return;
    }

    var csvRows = [];
    csvRows.push(['STT', 'Họ và tên', 'Email', 'Khoa / Viện', 'Bộ môn', 'Chức vụ', 'Học vị / Học hàm', 'Số bài báo KH', 'Số đề tài NCKH'].map(function(s) {
        return '"' + String(s).replace(/"/g, '""') + '"';
    }).join(','));

    data.users.forEach(function(u, idx) {
        var userDT = (data.daoTao || []).filter(function(dt) { return dt.email === u.email; });
        var hocHam = userDT.find(function(dt) { return dt.loai === 'Học hàm'; });
        var hocViList = userDT.filter(function(dt) { return dt.loai === 'Học vị' || !dt.loai; });
        
        var academicTitle = 'Cử nhân / Kỹ sư';
        if (hocHam && hocHam.hocVi) {
            academicTitle = hocHam.hocVi;
        } else if (hocViList.some(function(dt) { return String(dt.hocVi).includes('Tiến sĩ'); })) {
            academicTitle = 'Tiến sĩ';
        } else if (hocViList.some(function(dt) { return String(dt.hocVi).includes('Thạc sĩ'); })) {
            academicTitle = 'Thạc sĩ';
        }

        var paperCount = (data.congBo || []).filter(function(cb) { return cb.email === u.email; }).length;
        var projectCount = (data.deTai || []).filter(function(dt) { return dt.email === u.email; }).length;

        var row = [
            idx + 1,
            u.name || '',
            u.email || '',
            u.khoa || u.donVi || '',
            u.boMon || '',
            u.chucVu || '',
            academicTitle,
            paperCount,
            projectCount
        ];

        csvRows.push(row.map(function(s) {
            return '"' + String(s).replace(/"/g, '""') + '"';
        }).join(','));
    });

    var csvString = '\uFEFF' + csvRows.join('\r\n');
    var blob = new Blob([csvString], { type: 'text/csv;charset=utf-8;' });
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    var now = new Date();
    var dateStr = now.getFullYear() + ('0' + (now.getMonth() + 1)).slice(-2) + ('0' + now.getDate()).slice(-2);
    a.href = url;
    a.download = 'Bao_Cao_Thong_Ke_NCKH_HCMUTE_' + dateStr + '.csv';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);

    showToast('Đã xuất báo cáo thống kê thành công!', 'success');
}

// Hiển thị Modal từ chối truy cập khi tài khoản không có quyền Admin
function showAccessDeniedModal(email) {
    var emailSpan = document.getElementById('accessDeniedEmailSpan');
    if (emailSpan) emailSpan.innerText = email || '';
    openModal('accessDeniedModal');
}

// ================= HÀM LẤY KHÓA LƯU TRỮ RIÊNG THEO EMAIL =================
function getEmailKey() {
    var email = '';
    var emailInput = document.getElementById('emailInput');
    if (emailInput && emailInput.value && emailInput.value.trim() !== '') {
        email = emailInput.value.trim().toLowerCase();
    } else {
        try {
            var params = new URLSearchParams(window.location.search);
            var pEmail = params.get('email');
            if (pEmail && pEmail.trim() !== '') {
                email = pEmail.trim().toLowerCase();
            }
        } catch(e){}
        if (!email) {
            email = (sessionStorage.getItem('currentUserEmail') || '').trim().toLowerCase();
        }
    }
    return email ? ('lylich_data_' + email) : 'lylich_data_default';
}

// ================= QUẢN LÝ PHÂN QUYỀN ADMIN (SHEET ADMINS) =================
var adminCandidatesList = [];
var selectedAdminCandidateEmails = new Set();
var currentActingAdminEmail = '';

function openAddAdminModal() {
    openModal('addAdminModal');
    selectedAdminCandidateEmails.clear();
    updateSelectedAdminUI();
    
    var emailInput = document.getElementById('emailInput');
    currentActingAdminEmail = (emailInput && emailInput.value) ? emailInput.value.trim() : (sessionStorage.getItem('currentUserEmail') || '');

    var container = document.getElementById('adminCandidatesListContainer');
    if (container) {
        container.innerHTML = '<div class="text-center py-10 text-slate-400 text-xs">' +
            '<svg class="animate-spin h-6 w-6 text-blue-600 mx-auto mb-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg>' +
            '<span>Đang tải danh sách tài khoản từ Google Sheets...</span></div>';
    }

    if (typeof google !== 'undefined' && google.script && google.script.run) {
        google.script.run
            .withSuccessHandler(function(candidates) {
                adminCandidatesList = candidates || [];
                renderAdminCandidatesUI(adminCandidatesList);
            })
            .withFailureHandler(function(err) {
                if (container) {
                    container.innerHTML = '<div class="text-center py-8 text-rose-500 text-xs font-semibold">Lỗi tải dữ liệu: ' + (err.message || err) + '</div>';
                }
            })
            .getAdminCandidates();
    } else {
        // Dữ liệu mẫu demo offline
        setTimeout(function() {
            adminCandidatesList = [
                { email: "24124135@student.hcmute.edu.vn", name: "Nguyễn Văn Nghĩa", donVi: "Khoa CNTT", isAdmin: true, nguoiThem: "Hệ thống", ngayThem: "12/10/2026 10:00:00" },
                { email: "tuan.ta@hcmute.edu.vn", name: "PGS. TS. Trần Anh Tuấn", donVi: "Khoa Điện - Điện tử", isAdmin: false, nguoiThem: "", ngayThem: "" },
                { email: "lan.nt@hcmute.edu.vn", name: "TS. Nguyễn Thị Lan", donVi: "Khoa Kinh tế", isAdmin: false, nguoiThem: "", ngayThem: "" },
                { email: "hung.le@hcmute.edu.vn", name: "ThS. Lê Hoàng Hùng", donVi: "Khoa Cơ khí CTM", isAdmin: false, nguoiThem: "", ngayThem: "" },
                { email: "phuong.mai@hcmute.edu.vn", name: "TS. Mai Thanh Phương", donVi: "Khoa Hóa học & Khoa học sự sống", isAdmin: false, nguoiThem: "", ngayThem: "" }
            ];
            renderAdminCandidatesUI(adminCandidatesList);
        }, 300);
    }
}

function renderAdminCandidatesUI(list) {
    var container = document.getElementById('adminCandidatesListContainer');
    if (!container) return;

    if (!list || list.length === 0) {
        container.innerHTML = '<div class="text-center py-10 text-slate-400 text-xs font-medium">Không tìm thấy tài khoản nào trong Sheet Thông Tin Cơ Bản.</div>';
        return;
    }

    var html = '';
    for (var i = 0; i < list.length; i++) {
        var u = list[i];
        var isAdm = (u.isAdmin === true);
        var isChecked = selectedAdminCandidateEmails.has(u.email);
        
        // Tài khoản chưa vào admin sáng hơn, đã vào admin tối hơn
        var cardClass = isAdm 
            ? 'p-3 rounded-2xl border border-slate-200/60 bg-slate-100/70 opacity-60 text-slate-400 select-none' 
            : 'p-3 rounded-2xl border border-slate-200 bg-white hover:border-blue-300 hover:bg-blue-50/30 transition-all cursor-pointer shadow-sm';

        html += '<div class="' + cardClass + '" onclick="toggleCandidateRow(\'' + u.email + '\', ' + isAdm + ', event)">';
        html += '  <div class="flex items-center justify-between gap-3">';
        html += '    <div class="flex items-center gap-3 overflow-hidden">';
        
        if (isAdm) {
            html += '      <input type="checkbox" disabled checked class="w-4 h-4 rounded text-slate-400 cursor-not-allowed shrink-0">';
        } else {
            html += '      <input type="checkbox" id="chkCandidate_' + i + '" value="' + u.email + '" ' + (isChecked ? 'checked' : '') + ' onchange="toggleCandidateCheckbox(\'' + u.email + '\', this.checked)" class="w-4 h-4 text-blue-600 rounded cursor-pointer shrink-0">';
        }

        html += '      <div class="overflow-hidden">';
        html += '        <div class="flex items-center gap-2">';
        html += '          <span class="text-xs font-bold ' + (isAdm ? 'text-slate-500' : 'text-slate-800') + ' truncate">' + (u.name || u.email) + '</span>';
        if (isAdm) {
            html += '          <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-200 text-slate-600 shrink-0">Đã là Admin</span>';
        } else {
            html += '          <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-700 shrink-0">Chưa cấp quyền</span>';
        }
        html += '        </div>';
        html += '        <div class="flex items-center gap-2 text-[11px] mt-0.5 ' + (isAdm ? 'text-slate-400' : 'text-slate-500') + ' truncate">';
        html += '          <span class="font-mono font-medium">' + u.email + '</span>';
        if (u.donVi) html += '          <span>• ' + u.donVi + '</span>';
        if (isAdm && u.nguoiThem) html += '          <span>(Thêm bởi: ' + u.nguoiThem + ')</span>';
        html += '        </div>';
        html += '      </div>';
        html += '    </div>';

        html += '  </div>';
        html += '</div>';
    }

    container.innerHTML = html;
    updateSelectedAdminUI();
}

function toggleCandidateRow(email, isAdm, e) {
    if (isAdm) return;
    if (e.target && e.target.tagName === 'INPUT') return;
    if (selectedAdminCandidateEmails.has(email)) {
        selectedAdminCandidateEmails.delete(email);
    } else {
        selectedAdminCandidateEmails.add(email);
    }
    renderAdminCandidatesUI(getFilteredCandidates());
}

function toggleCandidateCheckbox(email, isChecked) {
    if (isChecked) {
        selectedAdminCandidateEmails.add(email);
    } else {
        selectedAdminCandidateEmails.delete(email);
    }
    updateSelectedAdminUI();
}

function toggleSelectAllCandidates(checked) {
    var filtered = getFilteredCandidates();
    for (var i = 0; i < filtered.length; i++) {
        if (!filtered[i].isAdmin) {
            if (checked) {
                selectedAdminCandidateEmails.add(filtered[i].email);
            } else {
                selectedAdminCandidateEmails.delete(filtered[i].email);
            }
        }
    }
    renderAdminCandidatesUI(filtered);
}

function getFilteredCandidates() {
    var searchEl = document.getElementById('adminCandidateSearch');
    var keyword = (searchEl ? searchEl.value : '').toLowerCase().trim();
    if (!keyword) return adminCandidatesList;
    return adminCandidatesList.filter(function(u) {
        var str = (u.email + ' ' + (u.name || '') + ' ' + (u.donVi || '')).toLowerCase();
        return str.includes(keyword);
    });
}

function filterAdminCandidates() {
    renderAdminCandidatesUI(getFilteredCandidates());
}

function updateSelectedAdminUI() {
    var count = selectedAdminCandidateEmails.size;
    var countEl = document.getElementById('selectedAdminCount');
    if (countEl) countEl.innerText = count;

    var btn = document.getElementById('btnProceedAddAdmin');
    if (btn) {
        btn.disabled = (count === 0);
    }

    var checkAll = document.getElementById('checkAllCandidates');
    if (checkAll) {
        var nonAdmins = getFilteredCandidates().filter(function(u) { return !u.isAdmin; });
        if (nonAdmins.length > 0 && count >= nonAdmins.length) {
            checkAll.checked = true;
        } else {
            checkAll.checked = false;
        }
    }
}

// Xác nhận 2 bước: hiển thị thông báo chính xác số ít/nhiều theo quy định
function openConfirmAdminModal() {
    var selected = Array.from(selectedAdminCandidateEmails);
    if (selected.length === 0) return;

    var textEl = document.getElementById('confirmAdminText');
    var boxEl = document.getElementById('confirmAdminEmailsBox');

    // 1 tài khoản: "Bạn đang thêm quyền admin cho tài khoản: ..."
    // 2 tài khoản trở lên: "Bạn đang thêm quyền admin cho các tài khoản: ..." (mỗi gmail 1 dòng)
    if (selected.length === 1) {
        textEl.innerText = "Bạn đang thêm quyền admin cho tài khoản:";
    } else {
        textEl.innerText = "Bạn đang thêm quyền admin cho các tài khoản:";
    }

    boxEl.innerText = selected.join('\n');
    openModal('confirmAdminModal');
}

function executeGrantAdminRoles() {
    var selected = Array.from(selectedAdminCandidateEmails);
    if (selected.length === 0) return;

    var btn = document.getElementById('btnExecuteGrantAdmin');
    if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white inline" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg> <span>Đang lưu vào Sheet Admins...</span>';
    }

    if (typeof google !== 'undefined' && google.script && google.script.run) {
        google.script.run
            .withSuccessHandler(function(res) {
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = '<span>Xác nhận thêm</span> <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>';
                }
                closeModal('confirmAdminModal');
                closeModal('addAdminModal');
                
                var count = (res && res.addedCount !== undefined) ? res.addedCount : selected.length;
                showToast("Đã cấp quyền Quản trị viên thành công cho " + count + " tài khoản!", "success");
            })
            .withFailureHandler(function(err) {
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = '<span>Xác nhận thêm</span>';
                }
                showToast("Lỗi khi cấp quyền Admin: " + (err.message || err), "error");
            })
            .grantAdminRoles(selected, currentActingAdminEmail);
    } else {
        setTimeout(function() {
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = '<span>Xác nhận thêm</span>';
            }
            closeModal('confirmAdminModal');
            closeModal('addAdminModal');
            showToast("Đã cấp quyền Quản trị viên thành công cho " + selected.length + " tài khoản!", "success");
        }, 500);
    }
}

