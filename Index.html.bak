    function filterTableSearch(inputId, tbodyId) {
        var input = document.getElementById(inputId).value.toLowerCase();
        var rows = document.querySelectorAll("#" + tbodyId + " tr");
        for (var i = 0; i < rows.length; i++) {
            if (rows[i].cells.length <= 1) continue; 
            var text = rows[i].innerText.toLowerCase();
            rows[i].style.display = text.includes(input) ? "" : "none";
        }
    }
    // ===== HỆ THỐNG THÔNG BÁO TOAST =====
    function showToast(message, type = 'success') {
        const toast = document.getElementById('toast');
        if (!toast) return;
        toast.innerText = message;
        toast.className = `fixed bottom-5 right-5 px-6 py-3 rounded shadow-lg text-white font-medium transition-opacity duration-300 z-50 ${type === 'success' ? 'bg-green-500' : 'bg-red-500'}`;
        toast.classList.remove('opacity-0', 'pointer-events-none');
        setTimeout(() => { toast.classList.add('opacity-0', 'pointer-events-none'); }, 3000);
    }

    var pdfjsLib = window['pdfjs-dist/build/pdf'];
    if(pdfjsLib) {
        pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.16.105/pdf.worker.min.js';
    }
    var currentYear = new Date().getFullYear();
    var appData = {
        basicInfo: {}, bosung: { monHoc: [], huongNghienCuu: [], prefs: {} },
        daotao: { hocVi: [], hocHam: [], ngoaiNgu: [] }, congTac: [], deTai: [], 
        congBo: { baiBao: [], seminar: [], sach: [] }, giaiThuong: { khcn: [], chuyenGiao: [] }
    };
    
    // --- ĐĂNG XUẤT ---
    function handleLogout() { 
        sessionStorage.removeItem('currentUserEmail');
        if (typeof google === 'undefined') {
            window.location.href = 'Login.html'; 
            return;
        }
        google.script.run.withSuccessHandler(function(url) {
            window.top.location.href = url + '?page=login';
        }).getScriptUrl();
    }
// HÀM CHUYỂN TRANG (TABS)
    // --- HÀM ĐIỀU KHIỂN SIDEBAR TRÊN MOBILE & DESKTOP ---
function toggleMobileSidebar() {
    var aside = document.getElementById('sidebar-aside');
    var backdrop = document.getElementById('sidebar-backdrop');
    if (!aside || !backdrop) return;
    
    var isOpen = aside.classList.contains('mobile-drawer-open');
    if (isOpen) {
        closeMobileSidebar();
    } else {
        aside.classList.add('mobile-drawer-open');
        aside.classList.remove('-translate-x-full');
        backdrop.classList.remove('hidden');
        document.body.classList.add('overflow-hidden');
    }
}

function closeMobileSidebar() {
    var aside = document.getElementById('sidebar-aside');
    var backdrop = document.getElementById('sidebar-backdrop');
    if (aside) {
        aside.classList.remove('mobile-drawer-open');
        if (window.innerWidth < 1024) {
            aside.classList.add('-translate-x-full');
        }
    }
    if (backdrop) backdrop.classList.add('hidden');
    document.body.classList.remove('overflow-hidden');
}

// Lắng nghe thay đổi kích thước màn hình để tự căn chỉnh menu
window.addEventListener('resize', function() {
    var aside = document.getElementById('sidebar-aside');
    var backdrop = document.getElementById('sidebar-backdrop');
    if (window.innerWidth >= 1024) {
        if (aside) {
            aside.classList.remove('-translate-x-full', 'mobile-drawer-open');
        }
        if (backdrop) backdrop.classList.add('hidden');
        document.body.classList.remove('overflow-hidden');
    } else {
        if (aside && !aside.classList.contains('mobile-drawer-open')) {
            aside.classList.add('-translate-x-full');
        }
    }
});

function switchSection(sectionId) {
    if (window.innerWidth < 1024) { closeMobileSidebar(); }
        var links = document.querySelectorAll('.sidebar-link[data-target]');
        var targetText = "Tổng quan"; // Lấy tên text để cập nhật Topbar
        
        links.forEach(function(link) {
            if (link.getAttribute('data-target') === sectionId) {
                link.classList.add('active');
                targetText = link.innerText.trim();
            } else {
                link.classList.remove('active');
            }
        });
        
        // Cập nhật Breadcrumb trên Topbar
        var breadcrumb = document.getElementById('breadcrumb-current');
        if (breadcrumb) breadcrumb.innerText = targetText;
        
        var sections = document.querySelectorAll('.content-section');
        sections.forEach(function(sec) {
            sec.classList.remove('active-section');
            sec.style.display = 'none';
        });
        
        var target = document.getElementById(sectionId);
        if (target) {
            target.classList.add('active-section');
            target.style.display = 'flex';
        }
    }

    // TÌM HÀM renderBosungTable() VÀ THAY THẾ BẰNG HÀM NÀY
    function renderBosungTable() {
        var tbody = document.getElementById('bosung-tbody');
        var dataList = currentBosungTab === 'mon-hoc' ? appData.bosung.monHoc : appData.bosung.huongNghienCuu;
        
        // GIAO DIỆN KHI CHƯA CÓ DỮ LIỆU (Giống ảnh mẫu)
        if (dataList.length === 0) {
            return tbody.innerHTML = `
                <tr>
                    <td colspan="4" class="py-12">
                        <div class="flex flex-col items-center justify-center text-gray-400">
                            <div class="relative mb-3">
                                <svg class="w-16 h-16 text-[#bfdbfe]" fill="currentColor" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm-1 2.5L17.5 9H13V4.5zM6 20V4h5v7h7v9H6z"/></svg>
                                <div class="absolute bottom-1 right-[-4px] bg-[#0ea5e9] rounded-full text-white p-0.5 border-2 border-[#f8fafc]">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
                                </div>
                            </div>
                            <span class="text-sm font-medium">Chưa có dữ liệu</span>
                        </div>
                    </td>
                </tr>`;
        }
        
        // Render dữ liệu nếu có
        var html = '';
        for(var i=0; i<dataList.length; i++) {
            var item = dataList[i];
            html += '<tr class="border-b border-gray-100 bg-white hover:bg-gray-50 transition-colors"><td class="py-3 px-4 text-sm text-gray-700">' + item.major + '</td><td class="py-3 px-4 text-sm text-center text-gray-700 font-medium">' + item.name + '</td><td class="py-3 px-4 text-sm text-right text-gray-700">' + item.desc + '</td><td class="p-3 text-right whitespace-nowrap w-24"><div class="flex justify-end space-x-2"><button onclick="openBosungModal(' + i + ')" class="text-yellow-500 border border-yellow-500 rounded p-1 hover:bg-yellow-50" title="Sửa"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg></button><button onclick="deleteBosungItem(' + i + ')" class="text-red-500 border border-red-500 rounded p-1 hover:bg-red-50" title="Xóa"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg></button></div></td></tr>';
        }
        tbody.innerHTML = html;
    }

    // Thêm hàm để đồng bộ hiển thị tên trên Topbar sau khi tải dữ liệu thành công
    // Tìm hàm updateWelcomeMessage() và thay bằng đoạn này:
    // Hàm chuẩn hóa viết hoa chữ cái đầu cho từng từ
    function formatCapitalizeWords(str) {
        if (!str) return '';
        return str.trim().split(/\s+/).map(function(w) {
            if (!w) return '';
            var upper = w.toUpperCase();
            // Bảo tồn các học hàm / học vị viết tắt phổ biến
            if (upper === 'PGS.' || upper === 'GS.' || upper === 'TS.' || upper === 'THS.' || upper === 'KS.') {
                return upper;
            }
            return w.charAt(0).toUpperCase() + w.slice(1).toLowerCase();
        }).join(' ');
    }

    // Cập nhật lời chào: Có tên -> hiện tên viết hoa chữ cái đầu; Chưa có tên -> hiện gmail/email
    function updateWelcomeMessage() {
        var emailInput = document.getElementById('emailInput');
        var nameInput = document.getElementById('nameInput');
        
        var email = (emailInput && emailInput.value) ? emailInput.value.trim() : ((appData && appData.basicInfo && appData.basicInfo.email) ? appData.basicInfo.email.trim() : (window.currentUserEmail || ''));
        var name = (nameInput && nameInput.value) ? nameInput.value.trim() : ((appData && appData.basicInfo && appData.basicInfo.name) ? appData.basicInfo.name.trim() : '');
        
        var displaySpan = document.getElementById('welcomeNameDisplay');
        var topbarSpan = document.getElementById('topbar-name');
        var topbarAvatar = document.getElementById('topbar-avatar');

        var displayName = '';
        if (name) {
            displayName = formatCapitalizeWords(name);
        } else if (email) {
            displayName = email;
        } else {
            displayName = 'Chưa cập nhật';
        }

        if (displaySpan) displaySpan.innerText = displayName;
        if (topbarSpan) topbarSpan.innerText = displayName;
        if (topbarAvatar && displayName && displayName !== 'Chưa cập nhật') {
            topbarAvatar.innerText = displayName.charAt(0).toUpperCase();
        }
    }
    // =====================================================================
    // HỆ THỐNG LƯU TẠM
    // =====================================================================
// Thay thế hàm saveToDatabase hiện tại bằng đoạn code sau:
function saveToDatabase() { 
    // Bọc localStorage trong try...catch để tránh lỗi ngắt trang web
    try {
        localStorage.setItem(getEmailKey(), JSON.stringify(appData)); 
    } catch(e) {
        console.warn("Trình duyệt chặn localStorage, bỏ qua lưu tạm.");
    }
    
    var indicator = document.getElementById('syncStatusIndicator');
    if(indicator) { 
        indicator.innerText = "Đã lưu tạm thời"; 
        indicator.style.opacity = "1"; 
        setTimeout(function(){ indicator.style.opacity = "0"; }, 2000);
    }
    
    // ĐỒNG BỘ LÊN GG SHEETS TỰ ĐỘNG
    if (typeof google !== 'undefined') {
        var email = document.getElementById('emailInput') ? document.getElementById('emailInput').value : '';
        if (email) {
            google.script.run.syncAllDataToSheets(email, appData, true);
        }
    }
}
function loadFromDatabase() {
    var stored = null;
    // Bọc localStorage để chặn lỗi làm đứng trang
    try {
        stored = localStorage.getItem(getEmailKey());
    } catch (e) {
        console.warn("Trình duyệt chặn localStorage.");
    }
    
    if (stored) {
        try {
            var parsed = JSON.parse(stored);
            if (parsed.basicInfo) appData.basicInfo = parsed.basicInfo;
            if (parsed.bosung) {
                appData.bosung.monHoc = parsed.bosung.monHoc || [];
                appData.bosung.huongNghienCuu = parsed.bosung.huongNghienCuu || [];
                appData.bosung.prefs = parsed.bosung.prefs || {};
            }
            if (parsed.daotao) {
                appData.daotao.hocVi = parsed.daotao.hocVi || [];
                appData.daotao.hocHam = parsed.daotao.hocHam || [];
                appData.daotao.ngoaiNgu = parsed.daotao.ngoaiNgu || [];
            }
            if (parsed.congTac) appData.congTac = parsed.congTac;
            if (parsed.deTai) appData.deTai = parsed.deTai;
            if (parsed.congBo) {
                appData.congBo.baiBao = parsed.congBo.baiBao || [];
                appData.congBo.seminar = parsed.congBo.seminar || [];
                appData.congBo.sach = parsed.congBo.sach || [];
            }
            if (parsed.giaiThuong) {
                appData.giaiThuong.khcn = parsed.giaiThuong.khcn || [];
                appData.giaiThuong.chuyenGiao = parsed.giaiThuong.chuyenGiao || [];
            }
        } catch (e) { console.error("Lỗi parse data:", e); }
    }
    
    // Các lệnh khởi tạo giao diện vẫn sẽ chạy bình thường dù localStorage có bị chặn
    populateBasicInfo(); populateBosungPrefs();
    renderBosungTable(); renderDaoTaoTable();
    renderCongTacTable(); renderDeTaiTable();
    renderGiaiThuongTable();
    initKhoaBoMon(); 
    populateYearFilter(); 
    updateDashboardStats();

    // Đồng bộ thêm từ Google Sheets nếu đang chạy online trên Google Apps Script
    if (typeof google !== 'undefined' && google.script && google.script.run) {
        var emailForProfile = (document.getElementById('emailInput') ? document.getElementById('emailInput').value : '') || sessionStorage.getItem('currentUserEmail');
        if (emailForProfile && emailForProfile.trim() !== '') {
            google.script.run.withSuccessHandler(function(serverData) {
                if (serverData && serverData.basicInfo && serverData.basicInfo.name) {
                    if (serverData.basicInfo) appData.basicInfo = Object.assign(appData.basicInfo || {}, serverData.basicInfo);
                    if (serverData.daoTao) {
                        if (serverData.daoTao.hocVi && serverData.daoTao.hocVi.length > 0) appData.daotao.hocVi = serverData.daoTao.hocVi;
                        if (serverData.daoTao.hocHam && serverData.daoTao.hocHam.length > 0) appData.daotao.hocHam = serverData.daoTao.hocHam;
                        if (serverData.daoTao.ngoaiNgu && serverData.daoTao.ngoaiNgu.length > 0) appData.daotao.ngoaiNgu = serverData.daoTao.ngoaiNgu;
                    }
                    if (serverData.congTac && serverData.congTac.length > 0) appData.congTac = serverData.congTac;
                    if (serverData.deTai && serverData.deTai.length > 0) appData.deTai = serverData.deTai;
                    if (serverData.congBo) {
                        if (serverData.congBo.baiBao && serverData.congBo.baiBao.length > 0) appData.congBo.baiBao = serverData.congBo.baiBao;
                        if (serverData.congBo.seminar && serverData.congBo.seminar.length > 0) appData.congBo.seminar = serverData.congBo.seminar;
                        if (serverData.congBo.sach && serverData.congBo.sach.length > 0) appData.congBo.sach = serverData.congBo.sach;
                    }
                    populateBasicInfo(); populateBosungPrefs();
                    renderBosungTable(); renderDaoTaoTable();
                    renderCongTacTable(); renderDeTaiTable();
                    renderGiaiThuongTable();
                    updateWelcomeMessage();
                    updateDashboardStats();
                    try { localStorage.setItem(getEmailKey(), JSON.stringify(appData)); } catch(e){}
                }
            }).getUserProfileData(emailForProfile);
        }
    }
}
    
    // Hàm tải dữ liệu thả xuống
    function loadDropdownData() {
        if(typeof google !== 'undefined' && google.script && google.script.run) {
            google.script.run.withSuccessHandler(function(data) {
                var queQuan = document.getElementById('queQuanInput');
                var noiSinh = document.getElementById('noiSinhInput');
                var danToc = document.getElementById('danTocInput');
                
                function populateSelect(selectEl, list) {
                    if(!selectEl) return;
                    var idKey = selectEl.id.replace('Input', '');
                    var currentVal = appData.basicInfo[idKey] || '';
                    selectEl.innerHTML = '<option value="">-- Chọn --</option>';
                    for (var i = 0; i < list.length; i++) {
                        var selected = (list[i] === currentVal) ? 'selected' : '';
                        selectEl.innerHTML += '<option value="' + list[i] + '" ' + selected + '>' + list[i] + '</option>';
                    }
                }
                
                populateSelect(queQuan, data.tinhThanh);
                populateSelect(noiSinh, data.tinhThanh);
                populateSelect(danToc, data.danToc);
