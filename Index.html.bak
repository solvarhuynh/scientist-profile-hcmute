  <!-- 13. MODAL PHÂN QUYỀN ADMIN (CHỌN GMAIL TỪ THÔNG TIN CƠ BẢN) -->
  <div id="addAdminModal" class="modal-overlay fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm items-center justify-center p-4" style="display: none;">
    <div class="bg-white rounded-3xl shadow-2xl w-full max-w-2xl overflow-hidden border border-slate-100 animate-scale-in flex flex-col max-h-[90vh]">
