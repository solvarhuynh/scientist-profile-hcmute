                  <a href="javascript:void(0)" onclick="openMergedPaperModal()" class="font-bold text-blue-700">🔍 Tra cứu / Thêm bài báo</a>
                  <a href="javascript:void(0)" onclick="openSeminarModal()">🎤 Seminar & Hội thảo</a>
                  <a href="javascript:void(0)" onclick="openSachModal()">📚 Sách giáo trình</a>
                </div>
              </div>
            </div>

            <!-- NỘI DUNG TABS CÔNG BỐ -->
            <div class="pro-card p-6 md:p-8">
              <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center pb-4 border-b border-slate-200 gap-3">
                <div class="flex gap-2">
                  <button id="tab-bai-bao" onclick="switchTab('congbo', 'bai-bao')" class="tab-btn active">
                    <span>Bài báo khoa học</span>
                  </button>
                  <button id="tab-seminar" onclick="switchTab('congbo', 'seminar')" class="tab-btn">
                    <span>Seminar & Hội thảo</span>
                  </button>
                  <button id="tab-sach" onclick="switchTab('congbo', 'sach')" class="tab-btn">
                    <span>Sách giáo trình</span>
                  </button>
                </div>

                <!-- Thanh tìm kiếm nhanh công bố -->
                <div class="w-full sm:w-64">
                  <div class="flex items-center bg-slate-50 border border-slate-200 rounded-xl px-3 py-1.5 focus-within:border-blue-500 focus-within:bg-white transition">
                    <svg class="w-4 h-4 text-slate-400 mr-2 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                    <input type="text" id="filterCongBoInput" onkeyup="filterCongBoTable()" placeholder="Tìm tên bài, tác giả, DOI..." class="bg-transparent text-xs outline-none w-full text-slate-700 font-medium">
                  </div>
                </div>
              </div>

              <div class="overflow-hidden border border-slate-200 rounded-2xl mt-4">
                <table class="table-modern w-full text-left">
                  <thead id="congbo-thead">
                    <tr>
                      <th class="p-3 w-12 text-center">TT</th>
                      <th class="p-3">Tên công trình</th>
                      <th class="p-3">Tác giả</th>
                      <th class="p-3 text-center">Năm XB</th>
                      <th class="p-3">Nơi xuất bản</th>
                      <th class="p-3 text-center">Chỉ số / DOI</th>
                      <th class="p-3 w-28 text-center">Minh chứng</th>
                      <th class="p-3 w-20 text-center">Thao tác</th>
                    </tr>
                  </thead>
                  <tbody id="congbo-tbody"></tbody>
                </table>
              </div>
            </div>

          </div>
        </section>

        <!-- =========================================================================
             SECTION: GIẢI THƯỞNG (CHỦ ĐỀ ROSE/FUCHSIA VINH DANH)
             ========================================================================= -->
        <section id="giai-thuong" class="content-section">
          <div class="max-w-7xl mx-auto w-full">
            
            <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-8 pb-4 border-b border-slate-200/80 gap-4">
              <div class="flex items-center">
                <span class="title-accent-bar bg-rose-500 shadow-sm shadow-rose-500/40"></span>
                <div>
                  <h1 class="text-2xl md:text-3xl font-extrabold text-slate-900 tracking-tight">Giải thưởng & SHTT</h1>
                  <p class="text-xs md:text-sm text-slate-500 mt-1">Giải thưởng Khoa học Công nghệ, Bằng sáng chế và Thành tựu Chuyển giao ứng dụng</p>
                </div>
              </div>

              <button onclick="openGiaiThuongModal()" class="bg-rose-600 hover:bg-rose-700 text-white px-4 py-2.5 rounded-xl font-bold text-xs flex items-center gap-2 shadow-sm transition">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                <span>Thêm giải thưởng</span>
              </button>
            </div>

            <div class="pro-card p-6 md:p-8">
              <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center pb-4 border-b border-slate-200 gap-3">
                <div class="flex gap-2">
                  <button id="tab-khcn" onclick="switchTab('giaithuong', 'khcn')" class="tab-btn active">
                    <span>Giải thưởng KHCN & Sáng chế</span>
                  </button>
                  <button id="tab-chuyen-giao" onclick="switchTab('giaithuong', 'chuyen-giao')" class="tab-btn">
                    <span>Chuyển giao công nghệ</span>
                  </button>
                </div>

                <div class="w-full sm:w-64">
                  <div class="flex items-center bg-slate-50 border border-slate-200 rounded-xl px-3 py-1.5 focus-within:border-rose-500 focus-within:bg-white transition">
                    <svg class="w-4 h-4 text-slate-400 mr-2 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                    <input type="text" id="searchGiaiThuong" onkeyup="filterTableSearch('searchGiaiThuong', 'giaithuong-tbody')" placeholder="Tìm kiếm giải thưởng..." class="bg-transparent text-xs outline-none w-full text-slate-700 font-medium">
                  </div>
                </div>
              </div>

              <div class="overflow-hidden border border-slate-200 rounded-2xl mt-4">
                <table class="table-modern w-full text-left">
                  <thead id="giaithuong-thead">
                    <tr>
                      <th class="p-3 w-12 text-center">TT</th>
                      <th class="p-3">Tên giải thưởng / Sáng chế</th>
                      <th class="p-3">Nơi cấp</th>
                      <th class="p-3 w-28 text-center">Năm cấp</th>
                      <th class="p-3">Nội dung chi tiết</th>
                      <th class="p-3 w-20 text-center">Thao tác</th>
                    </tr>
                  </thead>
                  <tbody id="giaithuong-tbody"></tbody>
                </table>
              </div>
            </div>

          </div>
        </section>

        <!-- =========================================================================
             SECTION: HỖ TRỢ & TRÍCH XUẤT TỰ ĐỘNG (CHỦ ĐỀ TEAL THÂN THIỆN)
             ========================================================================= -->
        <section id="ho-tro" class="content-section">
          <div class="max-w-5xl mx-auto w-full my-auto py-8">
            
            <div class="text-center mb-8">
              <span class="inline-block p-3 rounded-2xl bg-teal-50 text-teal-600 mb-3 border border-teal-100 shadow-sm">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
              </span>
              <h1 class="text-2xl md:text-3xl font-extrabold text-slate-900 tracking-tight">Trợ lý Trích xuất & Hỗ trợ</h1>
              <p class="text-sm text-slate-500 mt-2 max-w-xl mx-auto">
                Hệ thống hỗ trợ tự động đọc và chuyển đổi dữ liệu từ tệp tin Lý lịch khoa học sẵn có (PDF hoặc DOCX) vào hệ thống!
              </p>
            </div>

            <!-- Upload Card -->
            <div class="pro-card p-8 md:p-10 border-2 border-dashed border-teal-200 bg-teal-50/20 text-center max-w-2xl mx-auto">
              <div class="w-16 h-16 rounded-full bg-teal-100 text-teal-700 flex items-center justify-center mx-auto mb-4">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
              </div>
              <h3 class="text-base font-bold text-slate-800 mb-1">Tải lên file Lý lịch khoa học hiện có</h3>
              <p class="text-xs text-slate-500 mb-6">Định dạng hỗ trợ: .PDF hoặc .DOCX (Dung lượng tối đa 20MB)</p>
              
              <div class="flex items-center border border-slate-300 rounded-xl overflow-hidden bg-white shadow-sm max-w-lg mx-auto">
                <input type="file" id="cvFileInput" class="hidden" accept=".pdf,.docx" onchange="updateFileName(this)">
                <button type="button" onclick="document.getElementById('cvFileInput').click()" class="bg-slate-100 hover:bg-slate-200 border-r border-slate-300 px-4 py-2.5 text-xs font-bold text-slate-700 transition">
                  Chọn tệp tin
                </button>
                <div id="fileNameDisplay" class="flex-1 px-4 py-2.5 text-xs text-slate-500 overflow-hidden text-ellipsis whitespace-nowrap text-left font-medium">
                  Chưa chọn tệp tin nào
                </div>
                <button type="button" onclick="handleFileUpload(this)" class="bg-teal-600 hover:bg-teal-700 text-white px-6 py-2.5 text-xs font-bold transition">
                  Bắt đầu trích xuất
                </button>
              </div>
            </div>

            <!-- FAQ & Help Info -->
            <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6 text-left">
              <div class="pro-card p-5">
                <div class="w-8 h-8 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center mb-3">
                  <span class="text-sm font-bold">1</span>
                </div>
                <h4 class="text-xs font-bold text-slate-800 uppercase tracking-wider mb-1">Tự động nhận diện</h4>
                <p class="text-xs text-slate-500 leading-relaxed">Hệ thống phân tách tự động các mục học vị, đề tài, bài báo khoa học vào bảng tương ứng.</p>
              </div>
              
              <div class="pro-card p-5">
                <div class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center mb-3">
                  <span class="text-sm font-bold">2</span>
                </div>
                <h4 class="text-xs font-bold text-slate-800 uppercase tracking-wider mb-1">Lưu tạm & Xem lại</h4>
                <p class="text-xs text-slate-500 leading-relaxed">Dữ liệu sau trích xuất được lưu ở trạng thái bản nháp để Thầy/Cô kiểm tra trước khi đồng bộ.</p>
              </div>
              
              <div class="pro-card p-5">
                <div class="w-8 h-8 rounded-lg bg-purple-50 text-purple-600 flex items-center justify-center mb-3">
                  <span class="text-sm font-bold">3</span>
                </div>
                <h4 class="text-xs font-bold text-slate-800 uppercase tracking-wider mb-1">Hỗ trợ kỹ thuật</h4>
                <p class="text-xs text-slate-500 leading-relaxed">Liên hệ Phòng Quản lý Khoa học Công nghệ qua email: <span class="font-bold text-slate-700">qlkh@hcmute.edu.vn</span></p>
              </div>
            </div>

          </div>
        </section>

      </main>
  </div>

  <!-- =========================================================================
       HỆ THỐNG MODAL DIALOGS HIỆN ĐẠI (CHỐNG LỖI HIỂN THỊ, BACKDROP BLUR)
       ========================================================================= -->

  <!-- 1. MODAL BỔ SUNG (MÔN HỌC / HƯỚNG NGHIÊN CỨU) -->
  <div id="addBosungModal" class="modal-overlay fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm items-center justify-center p-4" style="display: none;">
    <div class="bg-white rounded-3xl shadow-2xl w-full max-w-xl overflow-hidden border border-slate-100 animate-scale-in">
      <div class="flex justify-between items-center p-5 border-b border-slate-100 bg-slate-50/50">
        <button onclick="closeModal('addBosungModal')" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-500 font-bold flex items-center justify-center transition">&times;</button>
        <h3 id="bosungModalTitle" class="text-base font-bold text-slate-800 text-center flex-1">Thêm môn học phụ trách</h3>
        <button onclick="saveBosungData()" class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2 rounded-xl font-bold text-xs shadow-sm transition">Lưu</button>
      </div>
      <div class="p-6 space-y-4">
        <div>
          <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Ngành / Chuyên ngành</label>
          <input id="modalMajor" type="text" placeholder="VD: Khoa học máy tính, Kỹ thuật cơ khí" class="input-clean w-full">
        </div>
        <div>
          <label id="modalNameLabel" class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Tên môn học</label>
          <input id="modalName" type="text" placeholder="Nhập tên môn học hoặc hướng nghiên cứu" class="input-clean w-full">
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Mô tả tóm tắt</label>
          <textarea id="modalDesc" class="input-clean w-full h-28 resize-none" placeholder="Nhập mô tả tóm tắt nội dung..."></textarea>
        </div>
      </div>
    </div>
  </div>

  <!-- 2. MODAL HỌC VỊ -->
  <div id="addHocViModal" class="modal-overlay fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm items-center justify-center p-4" style="display: none;">
    <div class="bg-white rounded-3xl shadow-2xl w-full max-w-2xl overflow-hidden border border-slate-100 animate-scale-in">
      <div class="flex justify-between items-center p-5 border-b border-slate-100 bg-slate-50/50">
        <button onclick="closeModal('addHocViModal')" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-500 font-bold flex items-center justify-center transition">&times;</button>
        <h3 id="titleHocViModal" class="text-base font-bold text-slate-800 text-center flex-1">Thêm học vị (Thạc sĩ, Tiến sĩ, Cử nhân, Kỹ sư)</h3>
        <button onclick="saveHocVi()" class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2 rounded-xl font-bold text-xs shadow-sm transition cursor-pointer">Lưu</button>
      </div>
      <div class="p-6 space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Học vị <span class="text-red-500">*</span></label>
            <select id="hocViSelect" onchange="handleHocViChange()" class="input-clean w-full">
              <option value="">-- Chọn học vị --</option>
              <optgroup label="🎓 Sau đại học (ThS, TS)">
                <option value="Thạc sĩ">Thạc sĩ (ThS)</option>
                <option value="Tiến sĩ">Tiến sĩ (TS / PhD)</option>
                <option value="Tiến sĩ khoa học">Tiến sĩ khoa học (TSKH)</option>
              </optgroup>
              <optgroup label="🎓 Bậc Đại học">
                <option value="Cử nhân">Cử nhân</option>
                <option value="Kỹ sư">Kỹ sư</option>
              </optgroup>
            </select>
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Bậc học / Hệ đào tạo</label>
            <select id="bacHocSelect" onchange="handleBacHocChange()" class="input-clean w-full">
              <option value="">-- Chọn bậc học --</option>
              <option value="Sau đại học">Sau đại học (Thạc sĩ, Tiến sĩ)</option>
              <option value="Đại học">Đại học (Cử nhân, Kỹ sư...)</option>
              <option value="Khác">Bậc khác</option>
            </select>
          </div>
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Ngành / Chuyên ngành đào tạo</label>
          <input type="text" id="nganhHocVi" placeholder="VD: Khoa học máy tính, Công nghệ thông tin..." class="input-clean w-full">
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Nơi đào tạo</label>
            <input type="text" id="noiDaoTaoHocVi" placeholder="Tên trường / Viện đào tạo..." class="input-clean w-full">
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Năm tốt nghiệp <span class="text-red-500">*</span></label>
            <input type="number" id="namTotNghiep" placeholder="YYYY (VD: 2020)" class="input-clean w-full">
          </div>
        </div>
        <div>
          <label id="dynamicHocViLabel" class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Tên luận văn / Luận án hoặc Hệ đào tạo</label>
          <input type="text" id="chiTietHocVi" placeholder="Tên đề tài tốt nghiệp / Luận văn ThS / Luận án TS..." class="input-clean w-full">
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Nước đào tạo</label>
          <input type="text" id="nuocDaoTaoHocVi" placeholder="VD: Việt Nam, Nhật Bản, Hoa Kỳ, Úc..." class="input-clean w-full">
        </div>
      </div>
    </div>
  </div>

  <!-- 3. MODAL HỌC HÀM -->
  <div id="addHocHamModal" class="modal-overlay fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm items-center justify-center p-4" style="display: none;">
    <div class="bg-white rounded-3xl shadow-2xl w-full max-w-lg overflow-hidden border border-slate-100 animate-scale-in">
      <div class="flex justify-between items-center p-5 border-b border-slate-100 bg-slate-50/50">
        <button onclick="closeModal('addHocHamModal')" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-500 font-bold flex items-center justify-center transition">&times;</button>
        <h3 id="titleHocHamModal" class="text-base font-bold text-slate-800 text-center flex-1">Thêm học hàm</h3>
        <button onclick="saveHocHam()" class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2 rounded-xl font-bold text-xs shadow-sm transition">Lưu</button>
      </div>
      <div class="p-6 space-y-4">
        <div>
          <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Chức danh học hàm</label>
          <select id="chucDanhHocHam" class="input-clean w-full"></select>
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Ngành được phong</label>
          <input type="text" id="nganhHocHam" placeholder="Chuyên ngành được phong tặng" class="input-clean w-full">
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Năm phong tặng</label>
          <input type="number" id="namPhongHocHam" placeholder="YYYY" class="input-clean w-full">
        </div>
      </div>
    </div>
  </div>

  <!-- 4. MODAL NGOẠI NGỮ -->
  <div id="addNgoaiNguModal" class="modal-overlay fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm items-center justify-center p-4" style="display: none;">
    <div class="bg-white rounded-3xl shadow-2xl w-full max-w-lg overflow-hidden border border-slate-100 animate-scale-in">
      <div class="flex justify-between items-center p-5 border-b border-slate-100 bg-slate-50/50">
        <button onclick="closeModal('addNgoaiNguModal')" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-500 font-bold flex items-center justify-center transition">&times;</button>
        <h3 id="titleNgoaiNguModal" class="text-base font-bold text-slate-800 text-center flex-1">Thêm ngoại ngữ</h3>
        <button onclick="saveNgoaiNgu()" class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2 rounded-xl font-bold text-xs shadow-sm transition">Lưu</button>
      </div>
      <div class="p-6 space-y-4">
        <div>
          <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Ngoại ngữ</label>
          <input type="text" id="ngonNguInput" list="languageList" placeholder="VD: Tiếng Anh, Tiếng Pháp, Tiếng Nhật..." class="input-clean w-full">
          <datalist id="languageList">
            <option value="Tiếng Anh"><option value="Tiếng Pháp"><option value="Tiếng Nga">
            <option value="Tiếng Đức"><option value="Tiếng Trung"><option value="Tiếng Nhật"><option value="Tiếng Hàn">
          </datalist>
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Mức độ sử dụng</label>
          <input type="text" id="mucDoNgonNguInput" placeholder="VD: Thành thạo, Khá, Giao tiếp..." class="input-clean w-full">
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Chứng chỉ / Điểm số</label>
          <textarea id="chungChiNgonNguInput" placeholder="Ghi rõ tên chứng chỉ, điểm số và năm cấp..." class="input-clean w-full h-24 resize-none"></textarea>
        </div>
      </div>
    </div>
  </div>

  <!-- 5. MODAL CÔNG TÁC -->
  <div id="addCongTacModal" class="modal-overlay fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm items-center justify-center p-4" style="display: none;">
    <div class="bg-white rounded-3xl shadow-2xl w-full max-w-xl overflow-hidden border border-slate-100 animate-scale-in">
      <div class="flex justify-between items-center p-5 border-b border-slate-100 bg-slate-50/50">
        <button onclick="closeModal('addCongTacModal')" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-500 font-bold flex items-center justify-center transition">&times;</button>
        <h3 id="titleCongTacModal" class="text-base font-bold text-slate-800 text-center flex-1">Thêm quá trình công tác</h3>
        <button onclick="saveCongTac()" class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2 rounded-xl font-bold text-xs shadow-sm transition">Lưu</button>
      </div>
      <div class="p-6 space-y-4">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-5 mb-5">
    <!-- Từ ngày: Chiếm 5 cột (nhỏ lại cho vừa vặn) -->
    <div class="md:col-span-5">
        <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Từ ngày</label>
        <input type="date" id="congTacTuNgay" class="input-clean w-full">
    </div>
    
    <!-- Đến ngày: Chiếm 7 cột (mở rộng thêm không gian cho 2 ô) -->
    <div class="md:col-span-7">
        <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Đến ngày</label>
        <div class="flex flex-row gap-2" id="congTacDenContainer">
            <select id="congTacDenLoai" onchange="toggleCongTacDen()" class="input-clean w-full transition-all duration-200">
                <option value="HienTai">Hiện tại</option>
                <option value="NgayKhac">Ngày khác</option>
            </select>
            <input type="date" id="congTacDenNgay" class="input-clean w-1/2 hidden transition-all duration-200">
        </div>
    </div>
</div>
        <div>
          <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Đơn vị công tác</label>
          <input type="text" id="congTacNoi" placeholder="Tên trường, viện, doanh nghiệp..." class="input-clean w-full">
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Chức danh / Vị trí</label>
          <input type="text" id="congTacChucDanh" placeholder="VD: Giảng viên, Trưởng bộ môn, Giám đốc..." class="input-clean w-full">
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Mô tả công việc</label>
          <textarea id="congTacMoTa" placeholder="Mô tả nhiệm vụ chuyên môn..." class="input-clean w-full h-24 resize-none"></textarea>
        </div>
      </div>
    </div>
  </div>

  <!-- 6. MODAL ĐỀ TÀI -->
  <div id="addDeTaiModal" class="modal-overlay fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm items-center justify-center p-4" style="display: none;">
    <div class="bg-white rounded-3xl shadow-2xl w-full max-w-2xl overflow-hidden border border-slate-100 animate-scale-in">
      <div class="flex justify-between items-center p-5 border-b border-slate-100 bg-slate-50/50">
        <button onclick="closeModal('addDeTaiModal')" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-500 font-bold flex items-center justify-center transition">&times;</button>
        <h3 id="titleDeTaiModal" class="text-base font-bold text-slate-800 text-center flex-1">Thêm đề tài nghiên cứu</h3>
        <button onclick="saveDeTai()" class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2 rounded-xl font-bold text-xs shadow-sm transition">Lưu</button>
      </div>
      <div class="p-6 space-y-4">
        <div>
          <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Tên đề tài</label>
          <input type="text" id="detaiTen" placeholder="Tên đầy đủ của đề tài nghiên cứu" class="input-clean w-full">
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Ngày bắt đầu</label>
            <input type="date" id="detaiBatDau" class="input-clean w-full">
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Ngày nghiệm thu</label>
            <input type="date" id="detaiNghiemThu" class="input-clean w-full">
          </div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Cấp đề tài</label>
            <input type="text" id="detaiCap" placeholder="Nhà nước, Bộ, Trường..." class="input-clean w-full">
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Xếp hạng</label>
            <input type="text" id="detaiXepHang" placeholder="Xuất sắc, Tốt, Khá..." class="input-clean w-full">
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Chức vụ trong đề tài</label>
            <input type="text" id="detaiChucVu" placeholder="Chủ nhiệm, Thư ký..." class="input-clean w-full">
          </div>
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Kinh phí đề tài</label>
          <div class="flex gap-2">
            <input type="number" id="detaiKinhPhi" placeholder="Nhập số tiền..." class="input-clean flex-1">
            <select id="detaiDonViTien" class="input-clean w-36">
              <option value="Triệu VNĐ">Triệu VNĐ</option>
              <option value="Tỷ VNĐ">Tỷ VNĐ</option>
              <option value="USD">USD</option>
            </select>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 7. MODAL SEMINAR -->
  <div id="addSeminarModal" class="modal-overlay fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm items-center justify-center p-4" style="display: none;">
    <div class="bg-white rounded-3xl shadow-2xl w-full max-w-xl overflow-hidden border border-slate-100 animate-scale-in">
      <div class="flex justify-between items-center p-5 border-b border-slate-100 bg-slate-50/50">
        <button onclick="closeModal('addSeminarModal')" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-500 font-bold flex items-center justify-center transition">&times;</button>
        <h3 class="text-base font-bold text-slate-800 text-center flex-1">Thêm Seminar & Hội thảo</h3>
        <button onclick="saveSeminar()" class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2 rounded-xl font-bold text-xs shadow-sm transition">Lưu</button>
      </div>
      <div class="p-6 space-y-4">
        <div>
          <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Hình thức tổ chức</label>
          <select id="seminarHinhThuc" class="input-clean w-full">
            <option value="Trực tiếp">Trực tiếp</option>
            <option value="Trực tuyến">Trực tuyến</option>
            <option value="Kết hợp">Kết hợp (Hybrid)</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Tên hội thảo / Chuyên đề</label>
          <input type="text" id="seminarTen" placeholder="Tên hội thảo hoặc bài báo cáo" class="input-clean w-full">
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Địa điểm tổ chức</label>
          <input type="text" id="seminarDiaDiem" placeholder="VD: Trường ĐH Công nghệ Kỹ thuật TP.HCM, Hà Nội..." class="input-clean w-full">
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Tháng</label>
            <input type="number" id="seminarThang" placeholder="MM" class="input-clean w-full">
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Năm</label>
            <input type="number" id="seminarNam" placeholder="YYYY" class="input-clean w-full" required>
          </div>
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Thông tin báo cáo / Kỷ yếu</label>
          <textarea id="seminarThongTin" placeholder="Tóm tắt nội dung báo cáo..." class="input-clean w-full h-24 resize-none"></textarea>
        </div>
      </div>
    </div>
  </div>

  <!-- 8. MODAL SÁCH -->
  <div id="addSachModal" class="modal-overlay fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm items-center justify-center p-4" style="display: none;">
    <div class="bg-white rounded-3xl shadow-2xl w-full max-w-xl overflow-hidden border border-slate-100 animate-scale-in">
      <div class="flex justify-between items-center p-5 border-b border-slate-100 bg-slate-50/50">
        <button onclick="closeModal('addSachModal')" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-500 font-bold flex items-center justify-center transition">&times;</button>
        <h3 class="text-base font-bold text-slate-800 text-center flex-1">Thêm sách giáo trình</h3>
        <button onclick="saveSach()" class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2 rounded-xl font-bold text-xs shadow-sm transition">Lưu</button>
      </div>
      <div class="p-6 space-y-4">
        <div>
          <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Tên sách / Giáo trình</label>
          <input type="text" id="sachTen" placeholder="Tên cuốn sách hoặc giáo trình" class="input-clean w-full">
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Nhà xuất bản</label>
          <input type="text" id="sachNoiXB" placeholder="VD: NXB Đại học Quốc gia, NXB Giáo dục..." class="input-clean w-full">
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Tháng</label>
            <input type="number" id="sachThang" placeholder="MM" class="input-clean w-full">
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Năm</label>
            <input type="number" id="sachNam" placeholder="YYYY" class="input-clean w-full">
          </div>
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Mã số ISBN / Vai trò biên soạn</label>
          <textarea id="sachThongTin" placeholder="Tác giả chính, đồng tác giả, chỉ số ISBN..." class="input-clean w-full h-24 resize-none"></textarea>
        </div>
      </div>
    </div>
  </div>

  <!-- 9. MODAL BÀI BÁO (TRA CỨU DOI & NHẬP THỦ CÔNG) -->
  <div id="mergedPaperModal" class="modal-overlay fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm items-center justify-center p-4" style="display: none;">
    <div class="bg-white rounded-3xl shadow-2xl w-full max-w-3xl overflow-hidden border border-slate-100 flex flex-col max-h-[90vh] animate-scale-in">
      <div class="flex justify-between items-center p-5 border-b border-slate-100 bg-slate-50/50 shrink-0">
        <button onclick="closeModal('mergedPaperModal')" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-500 font-bold flex items-center justify-center transition">&times;</button>
        <div class="flex items-center gap-2">
          <button onclick="toggleMergedPaperMode('search')" id="btnMergedSearchMode" class="px-4 py-1.5 rounded-xl font-bold text-xs bg-blue-600 text-white shadow-sm transition">Tra cứu Quốc tế (DOI / Crossref)</button>
          <button onclick="toggleMergedPaperMode('manual')" id="btnMergedManualMode" class="px-4 py-1.5 rounded-xl font-bold text-xs bg-slate-100 text-slate-700 hover:bg-slate-200 transition">Nhập thủ công</button>
        </div>
        <button onclick="submitMergedPaper()" class="bg-emerald-600 hover:bg-emerald-700 text-white px-5 py-2 rounded-xl font-bold text-xs shadow-sm transition">Lưu bài báo</button>
      </div>

      <!-- Chế độ tra cứu DOI -->
      <div id="mergedPaperSearchMode" class="flex-1 flex flex-col overflow-hidden p-6 space-y-4">
        <div class="flex gap-2">
          <input type="text" id="mergedSearchQuery" placeholder="Nhập tên bài báo tiếng Anh, mã DOI (VD: 10.1109/...) hoặc tên tác giả..." class="input-clean flex-1">
          <button onclick="executeMergedSearch()" class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2.5 rounded-xl font-bold text-xs shadow-sm transition flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            <span>Tra cứu</span>
          </button>
        </div>
        <div class="text-[11px] text-slate-500 italic">Hệ thống sẽ kết nối trực tiếp cơ sở dữ liệu CrossRef & OpenAlex để tự động điền thông tin tác giả, chỉ số IF và năm xuất bản.</div>
        <div id="mergedSearchResults" class="flex-1 overflow-y-auto space-y-3 pr-2"></div>
      </div>

      <!-- Chế độ nhập thủ công -->
      <div id="mergedPaperManualMode" class="flex-1 flex flex-col overflow-y-auto p-6 space-y-4 hidden">
        <div>
          <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Tên công trình bài báo <span class="text-red-500">*</span></label>
          <input type="text" id="manualTen" placeholder="Tên đầy đủ bài báo" class="input-clean w-full">
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Tác giả</label>
          <input type="text" id="manualTacGia" placeholder="VD: Nguyễn Văn A, Trần Văn B..." class="input-clean w-full">
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Tháng XB</label>
            <input type="number" id="manualThang" placeholder="MM" class="input-clean w-full">
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Năm XB <span class="text-red-500">*</span></label>
            <input type="number" id="manualNam" placeholder="YYYY" class="input-clean w-full">
          </div>
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Tạp chí / Nơi xuất bản</label>
          <input type="text" id="manualTapChi" placeholder="Tên tạp chí hoặc kỷ yếu" class="input-clean w-full">
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Mã ISSN</label>
            <input type="text" id="manualISSN" placeholder="VD: 1234-5678" class="input-clean w-full">
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Ngôn ngữ</label>
            <select id="manualNgonNgu" class="input-clean w-full">
              <option value="Tiếng Anh">Tiếng Anh</option>
              <option value="Tiếng Việt">Tiếng Việt</option>
              <option value="Tiếng khác">Tiếng khác</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Mã số DOI</label>
            <div class="flex gap-2">
              <input type="text" id="manualDOI" placeholder="VD: 10.1109/..." class="input-clean flex-1">
              <button type="button" onclick="autofillDOI()" class="bg-slate-100 hover:bg-slate-200 text-slate-700 px-3 py-2 rounded-xl text-xs font-bold">Auto</button>
            </div>
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Đường link bài báo</label>
            <input type="text" id="manualLink" placeholder="https://..." class="input-clean w-full">
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 10. MODAL GIẢI THƯỞNG -->
  <div id="addGiaiThuongModal" class="modal-overlay fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm items-center justify-center p-4" style="display: none;">
    <div class="bg-white rounded-3xl shadow-2xl w-full max-w-xl overflow-hidden border border-slate-100 animate-scale-in">
      <div class="flex justify-between items-center p-5 border-b border-slate-100 bg-slate-50/50">
        <button onclick="closeModal('addGiaiThuongModal')" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-500 font-bold flex items-center justify-center transition">&times;</button>
        <h3 class="text-base font-bold text-slate-800 text-center flex-1">Thêm giải thưởng / SHTT</h3>
        <button onclick="saveGiaiThuong()" class="bg-rose-600 hover:bg-rose-700 text-white px-5 py-2 rounded-xl font-bold text-xs shadow-sm transition">Lưu</button>
      </div>
      <div class="p-6 space-y-4">
        <div>
          <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Phân loại</label>
          <select id="gtLoai" onchange="toggleGiaiThuongFields()" class="input-clean w-full">
            <option value="khcn">Giải thưởng Khoa học & Công nghệ / Sáng chế</option>
            <option value="chuyenGiao">Thành tựu Chuyển giao công nghệ</option>
          </select>
        </div>
        <div>
          <label id="labelGtTen" class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Tên giải thưởng / Sáng chế</label>
          <input type="text" id="gtTen" class="input-clean w-full">
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label id="labelGtNoi" class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Nơi cấp</label>
            <input type="text" id="gtNoi" class="input-clean w-full">
          </div>
          <div>
            <label id="labelGtNam" class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Năm cấp</label>
            <input type="number" id="gtNam" class="input-clean w-full">
          </div>
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Nội dung chi tiết</label>
          <textarea id="gtNoiDung" class="input-clean w-full h-24 resize-none" placeholder="Mô tả nội dung giải thưởng hoặc hợp đồng chuyển giao..."></textarea>
        </div>
      </div>
    </div>
  </div>

  <!-- 11. MODAL UPLOAD MINH CHỨNG PDF -->
  <div id="uploadPdfModal" class="modal-overlay fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm items-center justify-center p-4" style="display: none;">
    <div class="bg-white rounded-3xl shadow-2xl w-full max-w-md overflow-hidden border border-slate-100 animate-scale-in">
      <div class="flex justify-between items-center p-5 border-b border-slate-100 bg-slate-50/50">
        <h3 class="text-base font-bold text-slate-800">Tải lên file PDF minh chứng</h3>
        <button onclick="closeModal('uploadPdfModal')" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-500 font-bold flex items-center justify-center transition">&times;</button>
      </div>
      <div class="p-6 space-y-4">
        <input type="hidden" id="pdfRecordId">
        <p class="text-xs text-slate-500">Tải lên tệp tin PDF toàn văn bài báo hoặc trang bìa kỷ yếu để chuyển trạng thái hồ sơ sang đã duyệt.</p>
        <div class="flex items-center border border-slate-300 rounded-xl overflow-hidden bg-white shadow-sm">
          <input type="file" id="pdfFileInput" accept="application/pdf" class="hidden" onchange="updatePdfFileName(this)">
          <button type="button" onclick="document.getElementById('pdfFileInput').click()" class="bg-slate-100 hover:bg-slate-200 border-r border-slate-300 px-4 py-2.5 text-xs font-bold text-slate-700 transition">
            Chọn PDF
          </button>
          <div id="pdfFileNameDisplay" class="flex-1 px-4 py-2.5 text-xs text-slate-500 overflow-hidden text-ellipsis whitespace-nowrap font-medium">
            Chưa chọn tệp tin
          </div>
        </div>
        <button onclick="submitPdfUpload()" id="btnSubmitPdf" class="w-full bg-blue-600 hover:bg-blue-700 text-white py-3 rounded-xl font-bold text-xs shadow-sm transition">
          Tải lên Google Drive
        </button>
      </div>
    </div>
  </div>

  <!-- 12. MODAL EXPORT CV -->
  <div id="exportModal" class="modal-overlay fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm items-center justify-center p-4" style="display: none;">
    <div class="bg-white rounded-3xl shadow-2xl w-full max-w-lg overflow-hidden border border-slate-100 animate-scale-in">
      <div class="flex justify-between items-center p-5 border-b border-slate-100 bg-slate-50/50">
        <h3 class="text-base font-bold text-slate-800">Tùy chọn Xuất Lý lịch khoa học (Word)</h3>
        <button onclick="closeModal('exportModal')" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-500 font-bold flex items-center justify-center transition">&times;</button>
      </div>
      <div class="p-6 space-y-4">
        <p class="text-xs text-slate-600 leading-relaxed">Chọn các mục bổ sung bạn muốn xuất kèm theo Mẫu chuẩn Lý lịch khoa học Bộ Giáo dục và Đào tạo:</p>
        <div class="space-y-3 bg-slate-50 p-4 rounded-2xl border border-slate-200/80">
          <label class="flex items-center gap-3 cursor-pointer">
            <input type="checkbox" id="exportOptionAwards" class="w-4 h-4 text-blue-600 rounded">
            <span class="text-xs font-semibold text-slate-700">Kèm theo Danh sách Giải thưởng & Sở hữu trí tuệ</span>
          </label>
          <label class="flex items-center gap-3 cursor-pointer">
