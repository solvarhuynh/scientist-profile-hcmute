{
  "name": "hcmute-scientific-cv-portal",
  "version": "3.0.0",
  "description": "Cổng Thông tin Lý lịch Khoa học & Quản lý Giảng viên HCMUTE (Modern React + Vite + Node.js + Supabase)",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "client:dev": "npm --prefix client run dev",
    "server:dev": "npm --prefix server run dev",
    "client:build": "npm --prefix client run build",
    "server:start": "npm --prefix server run start",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server run start"
  },
  "keywords": [
    "hcmute",
    "scientific-cv",
    "react",
    "vite",
    "nodejs",
    "express",
    "supabase",
    "postgresql",
    "tailwind-css",
    "phu-luc-iii"
  ],
  "author": "HCMUTE Development Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
